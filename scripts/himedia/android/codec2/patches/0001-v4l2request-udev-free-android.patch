+/* udev-free device lookup (Android has no libudev): resolve a char devnum to a
+ * /dev node by scanning /dev for a node with that st_rdev. */
+static int v4l2request_devnum_to_path(dev_t devnum, char *path, size_t size)
+{
+    DIR *dir = opendir("/dev");
+    struct dirent *ent;
+    int ret = AVERROR(ENOENT);
+
+    if (!dir)
+        return AVERROR(errno);
+
+    while ((ent = readdir(dir))) {
+        struct stat st;
+
+        if (strncmp(ent->d_name, "video", 5))
+            continue;
+        snprintf(path, size, "/dev/%s", ent->d_name);
+        if (stat(path, &st) == 0 && S_ISCHR(st.st_mode) && st.st_rdev == devnum) {
+            ret = 0;
+            break;
+        }
+    }
+    closedir(dir);
+    return ret;
+}
