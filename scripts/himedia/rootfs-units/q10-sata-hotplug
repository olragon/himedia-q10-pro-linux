#!/bin/bash
# q10-sata-hotplug — make the Q10's SATA bay hot-pluggable.
#   q10-sata-hotplug watch     (q10-sata-hotplug.service) poll the link; attach + mount on insert,
#                              detach on removal
#   q10-sata-hotplug eject     safe removal: sync, unmount, spin down, detach; panel says REMOVE
#   q10-sata-hotplug status    link speed, disk, mounts
#
# Why a poller: on an empty port the kernel only notices a new disk if the AHCI hotplug interrupt
# fires, and on this board nothing was logged when a disk was connected live (2026-10-12). A libata
# scan (`echo "- - -" > /sys/class/scsi_host/hostN/scan`) does the same link reset the error handler
# does — no module reload, no risk to the running system — and costs one log line, hence 10 s.
# Mounts: every partition with a filesystem goes to /media/<LABEL or UUID>, READ-ONLY — except our own
# labels (Q10_SATA_RW_LABELS, default "q10root q10music"), which mount rw. A disk someone plugs in is
# their data: a Windows NTFS disk was the first one hot-plugged here (2026-10-12), never write it.
set -uo pipefail
PORT=${Q10_SATA_PORT:-ata1}
INTERVAL=${Q10_SATA_INTERVAL:-10}
EJECTED=/run/q10/sata-ejected
PANEL=/usr/local/sbin/q10-panel
RW_LABELS=${Q10_SATA_RW_LABELS:-q10root q10music}

log() { echo "q10-sata-hotplug: $*"; logger -t q10-sata-hotplug "$*" 2>/dev/null || true; }
host() { local h; h=$(ls -d /sys/class/ata_port/$PORT/device/host* 2>/dev/null | head -1); basename "${h:-none}"; }
speed() { cat "/sys/class/ata_link/link${PORT#ata}/sata_spd" 2>/dev/null || echo "<unknown>"; }
disk() {  # the block device behind the port, e.g. sdb (empty if none)
  local b; b=$(ls -d /sys/class/ata_port/$PORT/device/host*/target*/*/block/* 2>/dev/null | head -1)
  [ -n "$b" ] && basename "$b"
}
rescan() { local h; h=$(host); [ "$h" != none ] && echo "- - -" > "/sys/class/scsi_host/$h/scan" 2>/dev/null; }

panel_msg() {  # panel_msg TEXT SECONDS — pause the clock so it cannot overwrite the message
  [ -x "$PANEL" ] || return 0
  systemctl stop q10-hud.service 2>/dev/null
  "$PANEL" text "$1" 7 >/dev/null 2>&1
  ( sleep "$2"; systemctl start q10-hud.service 2>/dev/null ) &
}

mount_all() {
  local d=$1 part fs label uuid dir
  for part in /dev/${d}[0-9]* /dev/$d; do
    [ -b "$part" ] || continue
    fs=$(blkid -s TYPE -o value "$part" 2>/dev/null); [ -n "$fs" ] || continue
    findmnt -rn -S "$part" >/dev/null && continue
    label=$(blkid -s LABEL -o value "$part" 2>/dev/null); uuid=$(blkid -s UUID -o value "$part" 2>/dev/null)
    dir=/media/${label:-$uuid}; dir=${dir// /_}
    mkdir -p "$dir"
    opts=ro,noatime
    case " $RW_LABELS " in *" $label "*) [ -n "$label" ] && opts=rw,noatime ;; esac
    if mount -o "$opts" "$part" "$dir" 2>/dev/null; then log "mounted $part ($fs, $opts) at $dir"; else log "could not mount $part ($fs)"; fi
  done
}

unmount_all() {  # returns 1 if something is still busy
  local d=$1 m rc=0
  while read -r m; do
    [ -n "$m" ] || continue
    if ! umount "$m" 2>/dev/null; then log "busy: $m — $(fuser -vm "$m" 2>&1 | tail -n +2 | awk '{print $NF}' | sort -u | tr '\n' ' ')"; rc=1; fi
  done < <(lsblk -lnpo MOUNTPOINT "/dev/$d" 2>/dev/null | grep -v '^$' | sort -r)
  return $rc
}

watch() {
  mkdir -p /run/q10
  local had="" cur
  log "watching $PORT every ${INTERVAL}s"
  while true; do
    cur=$(disk)
    if [ -n "$cur" ] && [ "$cur" != "$had" ]; then
      log "disk arrived: /dev/$cur ($(cat /sys/block/$cur/device/model 2>/dev/null | xargs), $(speed))"
      sleep 2; udevadm settle -t 10 2>/dev/null; mount_all "$cur"; panel_msg "DISK" 3
    elif [ -z "$cur" ] && [ -n "$had" ]; then
      log "disk gone: /dev/$had"
      # a pulled disk leaves stale mounts; detach them lazily so nothing hangs on them
      grep -E "^/dev/${had}[0-9]* " /proc/mounts | awk '{print $2}' | sort -r | xargs -r -n1 umount -l 2>/dev/null
      panel_msg "NODISK" 3
    fi
    had=$cur
    if [ -z "$cur" ]; then
      if [ -e "$EJECTED" ]; then
        # ejected but maybe still connected: never re-attach it behind the user's back
        [ "$(speed)" = "<unknown>" ] && rm -f "$EJECTED"
      else
        rescan
      fi
    elif [ "$(speed)" = "<unknown>" ]; then
      rescan   # link lost under an attached disk (pulled without eject): let libata detach it now
    fi
    sleep "$INTERVAL"
  done
}

eject() {
  local d; d=$(disk)
  [ -n "$d" ] || { echo "no SATA disk attached"; return 0; }
  mkdir -p /run/q10; touch "$EJECTED"
  panel_msg "EJECT" 60
  sync
  if ! unmount_all "$d"; then
    rm -f "$EJECTED"; panel_msg "BUSY" 5
    echo "eject refused: a filesystem on /dev/$d is in use (see journal)"; return 1
  fi
  command -v hdparm >/dev/null && hdparm -y "/dev/$d" >/dev/null 2>&1   # spin down, heads parked
  sleep 2
  echo 1 > "/sys/block/$d/device/delete"
  log "ejected /dev/$d — safe to remove"
  panel_msg "REMOVE" 20
  echo "safe to remove the disk"
}

status() {
  local d; d=$(disk)
  echo "port: $PORT  link: $(speed)  host: $(host)"
  if [ -n "$d" ]; then
    echo "disk: /dev/$d  $(cat /sys/block/$d/device/model 2>/dev/null | xargs)  $(lsblk -dno SIZE /dev/$d)"
    lsblk -no NAME,FSTYPE,LABEL,MOUNTPOINT "/dev/$d"
  else
    echo "disk: none$([ -e "$EJECTED" ] && echo ' (ejected; not re-attached until removed)')"
  fi
}

case "${1:-}" in
  watch) watch ;;
  eject) eject ;;
  status) status ;;
  *) sed -n '2,6p' "$0"; exit 2 ;;
esac
