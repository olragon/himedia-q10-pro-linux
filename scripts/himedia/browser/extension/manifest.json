{
  "manifest_version": 3,
  "name": "Play in mpv (HW)",
  "version": "1.0.0",
  "description": "Hand web video to the hardware-decoding mpv on the Q10 Pro through a native-messaging host.",
  "key": "",
  "icons": { "48": "icon48.png" },
  "permissions": ["nativeMessaging", "contextMenus", "notifications"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Play this page in mpv (HW)", "default_icon": { "48": "icon48.png" } },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true }
  ]
}
