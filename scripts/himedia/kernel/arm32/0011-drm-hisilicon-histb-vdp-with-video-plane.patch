+static u32 pack10(s16 c0, s16 c1, s16 c2)
+{
+	return ((u16)c0 & GENMASK(9, 0)) |
+	       (((u16)c1 & GENMASK(9, 0)) << 10) |
+	       (((u16)c2 & GENMASK(9, 0)) << 20);
+}
+
+static u32 pack16(s16 c0, s16 c1)
+{
+	return (u16)c0 | (u32)(u16)c1 << 16;
+}
+
+static void put_hl8(__le32 *dst, const s16 coef[17][8])
+{
+	unsigned int ph;
+
+	for (ph = 0; ph < 17; ph++) {
+		const s16 *c = coef[ph];
+
+		dst[ph * 3] = cpu_to_le32(pack10(c[0], c[1], c[2]));
+		dst[ph * 3 + 1] = cpu_to_le32(pack10(c[3], c[4], c[5]));
+		dst[ph * 3 + 2] = cpu_to_le32(pack10(c[6], c[7], 0));
+	}
+}
+
+static void put_4t(__le32 *dst, const s16 coef[17][4])
+{
+	unsigned int ph;
+
+	for (ph = 0; ph < 17; ph++) {
+		dst[ph * 2] = cpu_to_le32(pack16(coef[ph][0], coef[ph][1]));
+		dst[ph * 2 + 1] = cpu_to_le32(pack16(coef[ph][2], coef[ph][3]));
+	}
+}
+
+static const s16 (*pick_hl8(unsigned int in, unsigned int out))[8]
+{
+	if (out > in)
+		return histb_vdp_zme_hl8_up;
+	if (out == in)
+		return histb_vdp_zme_hl8_exact;
+	if ((u64)out * 2 >= in)
+		return histb_vdp_zme_hl8_mid;
+	return histb_vdp_zme_hl8_low;
+}
+
+static const s16 (*pick_4t(unsigned int in, unsigned int out))[4]
+{
+	if (out == in)
+		return histb_vdp_zme_4t_exact;
+	if (out > in || (u64)out * 2 >= in)
+		return histb_vdp_zme_4t_mid;
+	return histb_vdp_zme_4t_low;
+}
+
+/*
+ * Fill the 1 KiB coefficient window for one in -> out ratio:
+ *   +0x000 HL (8-tap luma H)   +0x100 HC (4-tap chroma H)
+ *   +0x200 VL (luma V)         +0x300 VC (4-tap chroma V)
+ * VL is a 6-tap table in the vendor path; its packing is unknown, so it is
+ * filled with the 4-tap packing and is only meaningful at 1:1 where the luma
+ * vertical FIR is off.  [inferred]
+ */
+void histb_vdp_zme_load(void *coef, unsigned int in_w, unsigned int out_w,
+			unsigned int in_h, unsigned int out_h)
+{
+	u8 *p = coef;
+
+	memset(p, 0, 0x400);
+	put_hl8((__le32 *)(p + 0x000), pick_hl8(in_w, out_w));
+	put_4t((__le32 *)(p + 0x100), pick_4t(in_w, out_w));
+	put_4t((__le32 *)(p + 0x200), pick_4t(in_h, out_h));
+	put_4t((__le32 *)(p + 0x300), pick_4t(in_h, out_h));
+}
