+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * DRM/KMS driver for the HiSilicon Hi3798CV200 video display processor.
+ *
+ * Unlike the community 6.12 histb-vdp driver, this one ADOPTS the pipe the
+ * bootloader started: one CRTC whose single mode is read back from DHD0, a
+ * primary plane on the G0 graphics layer and an overlay plane on the V0 video
+ * layer that scans out NV12/NV21 directly from CMA memory (zero copy from the
+ * histb-vdec decoder).  It never re-programs timing, clocks, the HDMI block or
+ * the VDP reset - see histb_vdp_hw.c for the exact write set.
+ *
+ * Nothing in this driver has run on hardware yet.
+ */
+
+#include <linux/aperture.h>
+#include <linux/clk.h>
+#include <linux/debugfs.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/uaccess.h>
+
+#include <drm/clients/drm_client_setup.h>
+#include <drm/drm_atomic.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_blend.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_crtc.h>
+#include <drm/drm_debugfs.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_encoder.h>
+#include <drm/drm_fb_dma_helper.h>
+#include <drm/drm_fbdev_dma.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_gem_atomic_helper.h>
+#include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_managed.h>
+#include <drm/drm_modeset_helper.h>
+#include <drm/drm_plane_helper.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_simple_kms_helper.h>
+#include <drm/drm_vblank.h>
+
+#include "histb_vdp.h"
+
+bool histb_vdp_allow_scale;
+module_param_named(allow_scale, histb_vdp_allow_scale, bool, 0444);
+MODULE_PARM_DESC(allow_scale,
+		 "let the video plane scale through the ZME (coefficient tables are unverified); default 1:1 only");
+
+int histb_vdp_csc_scale2p = 10;
+module_param_named(csc_scale2p, histb_vdp_csc_scale2p, int, 0444);
+MODULE_PARM_DESC(csc_scale2p, "VDM YUV2RGB SCALE2P register value (vendor: 10)");
+
+int histb_vdp_csc_shift = 10;
+module_param_named(csc_shift, histb_vdp_csc_shift, int, 0444);
+MODULE_PARM_DESC(csc_shift, "fractional bits of the YUV2RGB coefficients (default 10)");
+
+static bool fbdev = true;
+module_param(fbdev, bool, 0444);
+MODULE_PARM_DESC(fbdev, "register an fbdev/console client on the primary plane (default 1)");
+
+static bool allow_poke;
+module_param(allow_poke, bool, 0444);
+MODULE_PARM_DESC(allow_poke, "expose a debugfs register write file (debug only)");
+
+static const u32 primary_formats[] = {
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_ARGB8888,
+};
+
+static const u32 overlay_formats[] = {
+	DRM_FORMAT_NV12,
+	DRM_FORMAT_NV21,
+};
+
+static const u64 linear_only[] = {
+	DRM_FORMAT_MOD_LINEAR,
+	DRM_FORMAT_MOD_INVALID,
+};
+
+/* ---------------------------------------------------------------------- */
+/* planes                                                                 */
+/* ---------------------------------------------------------------------- */
+
+static int histb_vdp_primary_check(struct drm_plane *plane,
+				   struct drm_atomic_state *state)
+{
+	struct drm_plane_state *new = drm_atomic_get_new_plane_state(state, plane);
+	struct drm_crtc_state *crtc_state;
+	struct drm_framebuffer *fb = new->fb;
+	int ret;
+
+	if (!new->crtc || !fb)
+		return 0;
+
+	crtc_state = drm_atomic_get_crtc_state(state, new->crtc);
+	if (IS_ERR(crtc_state))
+		return PTR_ERR(crtc_state);
+
+	ret = drm_atomic_helper_check_plane_state(new, crtc_state,
+						  DRM_PLANE_NO_SCALING,
+						  DRM_PLANE_NO_SCALING,
+						  true, true);
+	if (ret || !new->visible)
+		return ret;
+
+	if (!IS_ALIGNED(fb->pitches[0], G0_STRIDE_UNIT) ||
+	    !IS_ALIGNED(drm_fb_dma_get_gem_addr(fb, new, 0), G0_STRIDE_UNIT))
+		return -EINVAL;
+
+	return 0;
+}
+
+static void histb_vdp_primary_update(struct drm_plane *plane,
+				     struct drm_atomic_state *state)
+{
+	struct histb_vdp *vdp = to_histb_vdp(plane->dev);
+	struct drm_plane_state *new = drm_atomic_get_new_plane_state(state, plane);
+
+	if (!new->visible)
+		histb_vdp_hw_g0_disable(vdp);
+	else
+		histb_vdp_hw_g0_update(vdp, new);
+}
+
+static void histb_vdp_primary_disable(struct drm_plane *plane,
+				      struct drm_atomic_state *state)
+{
+	histb_vdp_hw_g0_disable(to_histb_vdp(plane->dev));
+}
+
+static const struct drm_plane_helper_funcs histb_vdp_primary_helpers = {
+	.prepare_fb = drm_gem_plane_helper_prepare_fb,
+	.atomic_check = histb_vdp_primary_check,
+	.atomic_update = histb_vdp_primary_update,
+	.atomic_disable = histb_vdp_primary_disable,
+};
+
+static int histb_vdp_overlay_check(struct drm_plane *plane,
+				   struct drm_atomic_state *state)
+{
+	struct drm_plane_state *new = drm_atomic_get_new_plane_state(state, plane);
+	struct drm_crtc_state *crtc_state;
+	struct drm_framebuffer *fb = new->fb;
+	int min = DRM_PLANE_NO_SCALING, max = DRM_PLANE_NO_SCALING;
+	u32 sx, sy, sw, sh;
+	int ret;
+
+	if (!new->crtc || !fb)
+		return 0;
+
+	crtc_state = drm_atomic_get_crtc_state(state, new->crtc);
+	if (IS_ERR(crtc_state))
+		return PTR_ERR(crtc_state);
+
+	if (histb_vdp_allow_scale) {
+		min = (1 << 16) / 16;	/* down to 1/16 */
+		max = 16 << 16;		/* up to 16x */
+	}
+
+	ret = drm_atomic_helper_check_plane_state(new, crtc_state, min, max,
+						  true, true);
+	if (ret || !new->visible)
+		return ret;
+
+	sx = new->src.x1 >> 16;
+	sy = new->src.y1 >> 16;
+	sw = drm_rect_width(&new->src) >> 16;
+	sh = drm_rect_height(&new->src) >> 16;
+
+	/* 4:2:0 chroma is half height/width: keep every crop edge on a chroma sample */
+	if ((sx | sy | sw | sh) & 1 || sw < 32 || sh < 32)
+		return -EINVAL;
+	/* fractional source coordinates would need sub-pixel phases */
+	if ((new->src.x1 | new->src.y1 | new->src.x2 | new->src.y2) & 0xffff)
+		return -EINVAL;
+	if (!histb_vdp_allow_scale &&
+	    (drm_rect_width(&new->dst) != sw || drm_rect_height(&new->dst) != sh))
+		return -EINVAL;
+
+	/* unit and alignment of the V0 addresses/strides are [inferred] 16 bytes */
+	if (!IS_ALIGNED(fb->pitches[0], 16) || !IS_ALIGNED(fb->pitches[1], 16) ||
+	    !IS_ALIGNED(fb->offsets[0], 16) || !IS_ALIGNED(fb->offsets[1], 16) ||
+	    fb->pitches[0] > 0xffff || fb->pitches[1] > 0xffff)
+		return -EINVAL;
+	if (!IS_ALIGNED(drm_fb_dma_get_gem_addr(fb, new, 0) - sx, 16) ||
+	    !IS_ALIGNED(drm_fb_dma_get_gem_addr(fb, new, 1) - sx, 16))
+		return -EINVAL;
+
+	return 0;
+}
+
+static void histb_vdp_overlay_update(struct drm_plane *plane,
+				     struct drm_atomic_state *state)
+{
+	struct histb_vdp *vdp = to_histb_vdp(plane->dev);
+	struct drm_plane_state *new = drm_atomic_get_new_plane_state(state, plane);
+
+	if (!new->visible)
+		histb_vdp_hw_v0_disable(vdp);
+	else
+		histb_vdp_hw_v0_update(vdp, new);
+}
+
+static void histb_vdp_overlay_disable(struct drm_plane *plane,
+				      struct drm_atomic_state *state)
+{
+	histb_vdp_hw_v0_disable(to_histb_vdp(plane->dev));
+}
+
+static const struct drm_plane_helper_funcs histb_vdp_overlay_helpers = {
+	.prepare_fb = drm_gem_plane_helper_prepare_fb,
+	.atomic_check = histb_vdp_overlay_check,
+	.atomic_update = histb_vdp_overlay_update,
+	.atomic_disable = histb_vdp_overlay_disable,
+};
+
+static const struct drm_plane_funcs histb_vdp_plane_funcs = {
+	.update_plane = drm_atomic_helper_update_plane,
+	.disable_plane = drm_atomic_helper_disable_plane,
+	.destroy = drm_plane_cleanup,
+	.reset = drm_atomic_helper_plane_reset,
+	.atomic_duplicate_state = drm_atomic_helper_plane_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_plane_destroy_state,
+};
+
+/* ---------------------------------------------------------------------- */
+/* CRTC                                                                   */
+/* ---------------------------------------------------------------------- */
+
+static int histb_vdp_crtc_check(struct drm_crtc *crtc, struct drm_atomic_state *state)
+{
+	struct histb_vdp *vdp = to_histb_vdp(crtc->dev);
+	struct drm_crtc_state *new = drm_atomic_get_new_crtc_state(state, crtc);
+
+	if (!new->enable)
+		return 0;
+
+	/* the timing generator is the bootloader's; only its own mode is valid */
+	if (!drm_mode_match(&new->mode, &vdp->mode,
+			    DRM_MODE_MATCH_TIMINGS | DRM_MODE_MATCH_FLAGS))
+		return -EINVAL;
+
+	return 0;
+}
+
+static void histb_vdp_crtc_enable(struct drm_crtc *crtc, struct drm_atomic_state *state)
+{
+	drm_crtc_vblank_on(crtc);
+}
+
+static void histb_vdp_crtc_disable(struct drm_crtc *crtc, struct drm_atomic_state *state)
+{
+	/* the display channel keeps running: only the planes are switched off */
+	drm_crtc_vblank_off(crtc);
+
+	spin_lock_irq(&crtc->dev->event_lock);
+	if (crtc->state->event) {
+		drm_crtc_send_vblank_event(crtc, crtc->state->event);
+		crtc->state->event = NULL;
+	}
+	spin_unlock_irq(&crtc->dev->event_lock);
+}
+
+static void histb_vdp_crtc_flush(struct drm_crtc *crtc, struct drm_atomic_state *state)
+{
+	struct drm_pending_vblank_event *event = crtc->state->event;
+
+	if (!event)
+		return;
+
+	crtc->state->event = NULL;
+	spin_lock_irq(&crtc->dev->event_lock);
+	if (crtc->state->active && drm_crtc_vblank_get(crtc) == 0)
+		drm_crtc_arm_vblank_event(crtc, event);
+	else
+		drm_crtc_send_vblank_event(crtc, event);
+	spin_unlock_irq(&crtc->dev->event_lock);
+}
+
+static const struct drm_crtc_helper_funcs histb_vdp_crtc_helpers = {
+	.atomic_check = histb_vdp_crtc_check,
+	.atomic_enable = histb_vdp_crtc_enable,
+	.atomic_disable = histb_vdp_crtc_disable,
+	.atomic_flush = histb_vdp_crtc_flush,
+};
+
+static int histb_vdp_enable_vblank(struct drm_crtc *crtc)
+{
+	histb_vdp_hw_vblank(to_histb_vdp(crtc->dev), true);
+	return 0;
+}
+
+static void histb_vdp_disable_vblank(struct drm_crtc *crtc)
+{
+	histb_vdp_hw_vblank(to_histb_vdp(crtc->dev), false);
+}
+
+static const struct drm_crtc_funcs histb_vdp_crtc_funcs = {
+	.reset = drm_atomic_helper_crtc_reset,
+	.destroy = drm_crtc_cleanup,
+	.set_config = drm_atomic_helper_set_config,
+	.page_flip = drm_atomic_helper_page_flip,
+	.atomic_duplicate_state = drm_atomic_helper_crtc_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_crtc_destroy_state,
+	.enable_vblank = histb_vdp_enable_vblank,
+	.disable_vblank = histb_vdp_disable_vblank,
+};
+
+static irqreturn_t histb_vdp_irq(int irq, void *data)
+{
+	struct histb_vdp *vdp = data;
+
+	if (!(vdp_rd(vdp, VDP_VOINTSTA) & VDP_INT_DHD0_VTTHD1))
+		return IRQ_NONE;
+
+	vdp_wr(vdp, VDP_VOMSKINTSTA, VDP_INT_DHD0_VTTHD1);
+	drm_crtc_handle_vblank(&vdp->crtc);
+
+	return IRQ_HANDLED;
+}
+
+/* ---------------------------------------------------------------------- */
+/* connector: one fixed, always-connected mode, no DDC                    */
+/* ---------------------------------------------------------------------- */
+
+static int histb_vdp_conn_get_modes(struct drm_connector *conn)
+{
+	struct histb_vdp *vdp = to_histb_vdp(conn->dev);
+	struct drm_display_mode *mode = drm_mode_duplicate(conn->dev, &vdp->mode);
+
+	if (!mode)
+		return 0;
+
+	drm_mode_probed_add(conn, mode);
+	return 1;
+}
+
+static enum drm_mode_status histb_vdp_conn_mode_valid(struct drm_connector *conn,
+						      const struct drm_display_mode *mode)
+{
+	struct histb_vdp *vdp = to_histb_vdp(conn->dev);
+
+	return drm_mode_match(mode, &vdp->mode,
+			      DRM_MODE_MATCH_TIMINGS | DRM_MODE_MATCH_FLAGS) ?
+	       MODE_OK : MODE_BAD;
+}
+
+static enum drm_connector_status histb_vdp_conn_detect(struct drm_connector *conn,
+						       bool force)
+{
+	return connector_status_connected;
+}
+
+static const struct drm_connector_helper_funcs histb_vdp_conn_helpers = {
+	.get_modes = histb_vdp_conn_get_modes,
+	.mode_valid = histb_vdp_conn_mode_valid,
+};
+
+static const struct drm_connector_funcs histb_vdp_conn_funcs = {
+	.detect = histb_vdp_conn_detect,
+	.fill_modes = drm_helper_probe_single_connector_modes,
+	.destroy = drm_connector_cleanup,
+	.reset = drm_atomic_helper_connector_reset,
+	.atomic_duplicate_state = drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_connector_destroy_state,
+};
+
+/* ---------------------------------------------------------------------- */
+/* debugfs                                                                */
+/* ---------------------------------------------------------------------- */
+
+#ifdef CONFIG_DEBUG_FS
+static int histb_vdp_regs_show(struct seq_file *m, void *data)
+{
+	histb_vdp_hw_dump(((struct drm_debugfs_entry *)m->private)->file.data, m); /* not vdp: drm_debugfs_add_file */
+	return 0;
+}
+
+static ssize_t histb_vdp_poke_write(struct file *file, const char __user *ubuf,
+				    size_t len, loff_t *ppos)
+{
+	struct histb_vdp *vdp = file->private_data;
+	unsigned int off, val;
+	char buf[48];
+
+	if (len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = 0;
+	if (sscanf(buf, "%i %i", &off, &val) != 2 || off >= 0x10000 || off & 3)
+		return -EINVAL;
+
+	vdp_wr(vdp, off, val);
+	return len;
+}
+
+static const struct file_operations histb_vdp_poke_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = histb_vdp_poke_write,
+};
+
+static void histb_vdp_debugfs_init(struct drm_minor *minor)
+{
+	struct histb_vdp *vdp = to_histb_vdp(minor->dev);
+
+	drm_debugfs_add_file(minor->dev, "histb_vdp_regs", histb_vdp_regs_show, vdp);
+	if (allow_poke)
+		debugfs_create_file("histb_vdp_poke", 0200, minor->debugfs_root,
+				    vdp, &histb_vdp_poke_fops);
+}
+#endif
+
+/* ---------------------------------------------------------------------- */
+/* driver                                                                 */
+/* ---------------------------------------------------------------------- */
+
+static const struct drm_mode_config_funcs histb_vdp_mode_config_funcs = {
+	.fb_create = drm_gem_fb_create,
+	.atomic_check = drm_atomic_helper_check,
+	.atomic_commit = drm_atomic_helper_commit,
+};
+
+DEFINE_DRM_GEM_DMA_FOPS(histb_vdp_fops);
+
+/* G0 and V0 take their line pitch in 16-byte units, so dumb buffers are 16-byte aligned */
+static int histb_vdp_dumb_create(struct drm_file *file, struct drm_device *drm,
+				 struct drm_mode_create_dumb *args)
+{
+	args->pitch = ALIGN(DIV_ROUND_UP(args->width * args->bpp, 8), G0_STRIDE_UNIT);
+	args->size = 0;
+
+	return drm_gem_dma_dumb_create_internal(file, drm, args);
+}
+
+static const struct drm_driver histb_vdp_driver = {
+	.driver_features = DRIVER_GEM | DRIVER_MODESET | DRIVER_ATOMIC,
+	.fops = &histb_vdp_fops,
+	DRM_GEM_DMA_DRIVER_OPS_WITH_DUMB_CREATE(histb_vdp_dumb_create),
+	DRM_FBDEV_DMA_DRIVER_OPS,
+#ifdef CONFIG_DEBUG_FS
+	.debugfs_init = histb_vdp_debugfs_init,
+#endif
+	.name = "histb-vdp",
+	.desc = "HiSilicon Hi3798CV200 display processor (adopting)",
+	.major = 1,
+	.minor = 0,
+};
+
+static int histb_vdp_create_planes(struct histb_vdp *vdp)
+{
+	struct drm_device *drm = &vdp->drm;
+	int ret;
+
+	ret = drm_universal_plane_init(drm, &vdp->primary, BIT(0),
+				       &histb_vdp_plane_funcs, primary_formats,
+				       ARRAY_SIZE(primary_formats), linear_only,
+				       DRM_PLANE_TYPE_PRIMARY, "G0");
+	if (ret)
+		return ret;
+	drm_plane_helper_add(&vdp->primary, &histb_vdp_primary_helpers);
+	/*
+	 * G0 sits above V0 in the mixer.  An opaque XRGB primary therefore
+	 * hides the video; set the primary's "alpha" to 0 (or use an ARGB
+	 * buffer with transparent pixels) to see the overlay through it.
+	 */
+	ret = drm_plane_create_alpha_property(&vdp->primary);
+	if (ret)
+		return ret;
+	ret = drm_plane_create_zpos_immutable_property(&vdp->primary, 1);
+	if (ret)
+		return ret;
+
+	ret = drm_universal_plane_init(drm, &vdp->overlay, BIT(0),
+				       &histb_vdp_plane_funcs, overlay_formats,
+				       ARRAY_SIZE(overlay_formats), linear_only,
+				       DRM_PLANE_TYPE_OVERLAY, "V0");
+	if (ret)
+		return ret;
+	drm_plane_helper_add(&vdp->overlay, &histb_vdp_overlay_helpers);
+	ret = drm_plane_create_zpos_immutable_property(&vdp->overlay, 0);
+	if (ret)
+		return ret;
+
+	return drm_plane_create_color_properties(&vdp->overlay,
+			BIT(DRM_COLOR_YCBCR_BT601) | BIT(DRM_COLOR_YCBCR_BT709),
+			BIT(DRM_COLOR_YCBCR_LIMITED_RANGE) |
+			BIT(DRM_COLOR_YCBCR_FULL_RANGE),
+			DRM_COLOR_YCBCR_BT709, DRM_COLOR_YCBCR_LIMITED_RANGE);
+}
+
+static int histb_vdp_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct histb_vdp *vdp;
+	struct drm_device *drm;
+	u32 fb_base, fb_size;
+	int ret;
+
+	vdp = devm_drm_dev_alloc(dev, &histb_vdp_driver, struct histb_vdp, drm);
+	if (IS_ERR(vdp))
+		return PTR_ERR(vdp);
+	drm = &vdp->drm;
+	spin_lock_init(&vdp->irq_lock);
+
+	vdp->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(vdp->base))
+		return PTR_ERR(vdp->base);
+	vdp->irq = platform_get_irq(pdev, 0);
+	if (vdp->irq < 0)
+		return vdp->irq;
+
+	/*
+	 * Clocks are optional: the bootloader already runs the whole pipe.
+	 * The V0 gate is the one it may have left off; the rest are held so
+	 * they cannot be gated while this driver owns the display.
+	 */
+	ret = devm_clk_bulk_get_all_enabled(dev, &vdp->clks);
+	if (ret < 0 && ret != -ENOENT)
+		return dev_err_probe(dev, ret, "enabling VDP clocks\n");
+	vdp->num_clks = max(ret, 0);
+
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return dev_err_probe(dev, ret, "DMA mask\n");
+
+	ret = histb_vdp_hw_read_mode(vdp, &vdp->mode);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "bootloader display not running or not progressive\n");
+	dev_info(dev, "adopting bootloader mode " DRM_MODE_FMT "\n",
+		 DRM_MODE_ARG(&vdp->mode));
+
+	histb_vdp_hw_snapshot_boot(vdp);
+
+	vdp->zme_coef = dmam_alloc_coherent(dev, SZ_4K, &vdp->zme_coef_dma, GFP_KERNEL);
+	if (!vdp->zme_coef)
+		return -ENOMEM;
+
+	ret = drmm_mode_config_init(drm);
+	if (ret)
+		return ret;
+	drm->mode_config.min_width = 32;
+	drm->mode_config.min_height = 32;
+	drm->mode_config.max_width = HISTB_VDP_MAX_W;
+	drm->mode_config.max_height = HISTB_VDP_MAX_H;
+	drm->mode_config.preferred_depth = 24;
+	drm->mode_config.funcs = &histb_vdp_mode_config_funcs;
+
+	ret = histb_vdp_create_planes(vdp);
+	if (ret)
+		return ret;
+
+	ret = drm_crtc_init_with_planes(drm, &vdp->crtc, &vdp->primary, NULL,
+					&histb_vdp_crtc_funcs, "DHD0");
+	if (ret)
+		return ret;
+	drm_crtc_helper_add(&vdp->crtc, &histb_vdp_crtc_helpers);
+
+	vdp->encoder.possible_crtcs = BIT(0);
+	ret = drm_simple_encoder_init(drm, &vdp->encoder, DRM_MODE_ENCODER_TMDS);
+	if (ret)
+		return ret;
+
+	ret = drm_connector_init(drm, &vdp->connector, &histb_vdp_conn_funcs,
+				 DRM_MODE_CONNECTOR_HDMIA);
+	if (ret)
+		return ret;
+	drm_connector_helper_add(&vdp->connector, &histb_vdp_conn_helpers);
+	ret = drm_connector_attach_encoder(&vdp->connector, &vdp->encoder);
+	if (ret)
+		return ret;
+
+	ret = drm_vblank_init(drm, 1);
+	if (ret)
+		return ret;
+	/* the interrupt stays masked in VOINTMSK until a vblank is requested */
+	vdp_wr(vdp, VDP_VOINTMSK, 0);
+	ret = devm_request_irq(dev, vdp->irq, histb_vdp_irq, 0, dev_name(dev), vdp);
+	if (ret)
+		return dev_err_probe(dev, ret, "VDP IRQ\n");
+
+	drm_mode_config_reset(drm);
+	platform_set_drvdata(pdev, vdp);
+
+	/*
+	 * Take over from simpledrm.  Only the boot framebuffer's address range
+	 * is named, so no other platform framebuffer is touched.  The
+	 * reserved-memory region itself is left alone.
+	 */
+	if (histb_vdp_hw_boot_fb(vdp, &fb_base, &fb_size)) {
+		ret = aperture_remove_conflicting_devices(fb_base, fb_size,
+							  histb_vdp_driver.name);
+		if (ret)
+			return ret;
+	}
+
+	ret = drm_dev_register(drm, 0);
+	if (ret)
+		return ret;
+
+	if (fbdev)
+		drm_client_setup_with_fourcc(drm, DRM_FORMAT_XRGB8888);
+
+	return 0;
+}
+
+static void histb_vdp_remove(struct platform_device *pdev)
+{
+	struct histb_vdp *vdp = platform_get_drvdata(pdev);
+
+	drm_dev_unplug(&vdp->drm);
+	drm_atomic_helper_shutdown(&vdp->drm);
+	/*
+	 * Leave the display alive and showing the bootloader's buffer rather
+	 * than scanning freed memory.  simpledrm does NOT come back by itself.
+	 */
+	histb_vdp_hw_restore_boot(vdp);
+}
+
+static const struct of_device_id histb_vdp_of_match[] = {
+	{ .compatible = "hisilicon,hi3798cv200-vdp" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, histb_vdp_of_match);
+
+static struct platform_driver histb_vdp_platform_driver = {
+	.probe = histb_vdp_probe,
+	.remove = histb_vdp_remove,
+	.driver = {
+		.name = "histb-vdp",
+		.of_match_table = histb_vdp_of_match,
+	},
+};
+module_platform_driver(histb_vdp_platform_driver);
+
