+/* ---------------------------------------------------------------------- */
+/* adopted mode                                                           */
+/* ---------------------------------------------------------------------- */
+
+/*
+ * Read the running DHD0 timing back into a drm_display_mode.  The field
+ * encoding is the inverse of the community driver's histb_vdp_program_timing()
+ * [read histb-vdp.c:652-690]: HSYNC1 = (hdisp-1) | (hback+hsync-1) << 16,
+ * HSYNC2 = hfront-1, VSYNC = (vdisp-1) | (vback+vsync-1) << 12 |
+ * (vfront-1) << 22, PWR = (hsync-1) | (vsync-1) << 16.
+ * [measured] DHD0_CTRL = 0x80008010 on the box: enabled, progressive.
+ */
+int histb_vdp_hw_read_mode(struct histb_vdp *vdp, struct drm_display_mode *m)
+{
+	u32 ctrl = vdp_rd(vdp, VDP_DHD0_CTRL);
+	u32 hs1 = vdp_rd(vdp, VDP_DHD0_HSYNC1);
+	u32 hs2 = vdp_rd(vdp, VDP_DHD0_HSYNC2);
+	u32 vs = vdp_rd(vdp, VDP_DHD0_VSYNC);
+	u32 pwr = vdp_rd(vdp, VDP_DHD0_PWR);
+	u32 hact, hbb, hfb, hpw, vact, vbb, vfb, vpw;
+
+	if (!(ctrl & DHD0_CTRL_INTF_EN))
+		return -ENODEV;		/* the bootloader left no running display */
+	if (!(ctrl & DHD0_CTRL_IOP))
+		return -ENODEV;		/* interlaced: not adopted */
+
+	hact = FIELD_GET(GENMASK(15, 0), hs1) + 1;
+	hbb = FIELD_GET(GENMASK(31, 16), hs1) + 1;	/* back porch + sync */
+	hfb = FIELD_GET(GENMASK(15, 0), hs2) + 1;
+	hpw = FIELD_GET(GENMASK(15, 0), pwr) + 1;
+	vact = FIELD_GET(GENMASK(11, 0), vs) + 1;
+	vbb = FIELD_GET(GENMASK(21, 12), vs) + 1;
+	vfb = FIELD_GET(GENMASK(31, 22), vs) + 1;
+	vpw = FIELD_GET(GENMASK(31, 16), pwr) + 1;
+
+	if (hact < 320 || hact > HISTB_VDP_MAX_W ||
+	    vact < 240 || vact > HISTB_VDP_MAX_H ||
+	    hpw >= hbb || vpw >= vbb)
+		return -EINVAL;
+
+	memset(m, 0, sizeof(*m));
+	m->hdisplay = hact;
+	m->hsync_start = hact + hfb;
+	m->hsync_end = m->hsync_start + hpw;
+	m->htotal = hact + hfb + hbb;
+	m->vdisplay = vact;
+	m->vsync_start = vact + vfb;
+	m->vsync_end = m->vsync_start + vpw;
+	m->vtotal = vact + vfb + vbb;
+	/*
+	 * The register set holds no refresh rate.  60 Hz is assumed: it is only
+	 * used for vblank timestamping, and 1080p60 (htotal 2200, vtotal 1125)
+	 * gives exactly the CEA 148.5 MHz.  [inferred]
+	 */
+	m->clock = DIV_ROUND_CLOSEST_ULL((u64)m->htotal * m->vtotal * 60, 1000);
+	m->flags = DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC;
+	m->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_set_name(m);
+
+	return 0;
+}
+
+/* The boot-logo framebuffer G0 is scanning out, for the aperture handoff. */
+bool histb_vdp_hw_boot_fb(struct histb_vdp *vdp, u32 *base, u32 *size)
+{
+	u32 ctrl = vdp_rd(vdp, VDP_G0_CTRL);
+	u32 stride = FIELD_GET(GENMASK(15, 0), vdp_rd(vdp, VDP_G0_STRIDE)) *
+		     G0_STRIDE_UNIT;
+	u32 height = FIELD_GET(GENMASK(23, 12), vdp_rd(vdp, VDP_G0_IRESO)) + 1;
+
+	if (!(ctrl & G0_CTRL_ENABLE) || !stride)
+		return false;
+
+	*base = vdp_rd(vdp, VDP_G0_ADDR);
+	*size = stride * height;
+	return true;
+}
+
+/* ---------------------------------------------------------------------- */
+/* boot snapshot                                                          */
+/* ---------------------------------------------------------------------- */
+
+void histb_vdp_hw_snapshot_boot(struct histb_vdp *vdp)
+{
+	struct histb_vdp_boot_g0 *b = &vdp->boot;
+
+	b->ctrl = vdp_rd(vdp, VDP_G0_CTRL);
+	b->addr = vdp_rd(vdp, VDP_G0_ADDR);
+	b->naddr = vdp_rd(vdp, VDP_G0_NADDR);
+	b->stride = vdp_rd(vdp, VDP_G0_STRIDE);
+	b->ireso = vdp_rd(vdp, VDP_G0_IRESO);
+	b->sfpos = vdp_rd(vdp, VDP_G0_SFPOS);
+	b->dfpos = vdp_rd(vdp, VDP_G0_DFPOS);
+	b->dlpos = vdp_rd(vdp, VDP_G0_DLPOS);
+	b->vfpos = vdp_rd(vdp, VDP_G0_VFPOS);
+	b->vlpos = vdp_rd(vdp, VDP_G0_VLPOS);
+	b->cbmpara = vdp_rd(vdp, VDP_G0_CBMPARA);
+	b->alpha = vdp_rd(vdp, VDP_G0_ALPHA);
+	b->cbm_mix1 = vdp_rd(vdp, VDP_CBM_MIX1);
+	b->vp0_ctrl = vdp_rd(vdp, VDP_VP0_CTRL);
+}
+
+static void latch_g0(struct histb_vdp *vdp)
+{
+	/*
+	 * G0 and GP0 each have a shadow latch and the graphics path observes a
+	 * complete pair; read each request back to flush the posted write
+	 * before issuing the next.  [read community histb-vdp.c:470-478]
+	 */
+	writel(1, vdp->base + VDP_G0_UPD);
+	readl(vdp->base + VDP_G0_UPD);
+	writel(1, vdp->base + VDP_GP0_UPD);
+	readl(vdp->base + VDP_GP0_UPD);
+}
+
+/* Put G0 and the video mixer back the way the bootloader left them. */
+void histb_vdp_hw_restore_boot(struct histb_vdp *vdp)
+{
+	const struct histb_vdp_boot_g0 *b = &vdp->boot;
+
+	histb_vdp_hw_v0_disable(vdp);
+
+	vdp_wr(vdp, VDP_G0_ADDR, b->addr);
+	vdp_wr(vdp, VDP_G0_NADDR, b->naddr);
+	vdp_wr(vdp, VDP_G0_STRIDE, b->stride);
+	vdp_wr(vdp, VDP_G0_IRESO, b->ireso);
+	vdp_wr(vdp, VDP_G0_SFPOS, b->sfpos);
+	vdp_wr(vdp, VDP_G0_DFPOS, b->dfpos);
+	vdp_wr(vdp, VDP_G0_DLPOS, b->dlpos);
+	vdp_wr(vdp, VDP_G0_VFPOS, b->vfpos);
+	vdp_wr(vdp, VDP_G0_VLPOS, b->vlpos);
+	vdp_wr(vdp, VDP_G0_CBMPARA, b->cbmpara);
+	vdp_wr(vdp, VDP_G0_ALPHA, b->alpha);
+	vdp_wr(vdp, VDP_G0_CTRL, b->ctrl);
+	vdp_wr(vdp, VDP_CBM_MIX1, b->cbm_mix1);
+	latch_g0(vdp);
+}
+
+/* ---------------------------------------------------------------------- */
+/* vertical interrupt                                                     */
+/* ---------------------------------------------------------------------- */
+
+void histb_vdp_hw_vblank(struct histb_vdp *vdp, bool on)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&vdp->irq_lock, flags);
+	vdp->vblank_on = on;
+	if (on) {
+		/* clear a stale status, fire at the first blanking line */
+		vdp_wr(vdp, VDP_VOMSKINTSTA, VDP_INT_DHD0_VTTHD1);
+		vdp_rmw(vdp, VDP_DHD0_VTTHD, GENMASK(12, 0) | BIT(15),
+			vdp->mode.vdisplay & GENMASK(12, 0));
+		vdp_wr(vdp, VDP_VOINTMSK, VDP_INT_DHD0_VTTHD1);
+	} else {
+		vdp_wr(vdp, VDP_VOINTMSK, 0);
+	}
+	spin_unlock_irqrestore(&vdp->irq_lock, flags);
+}
+
+/* ---------------------------------------------------------------------- */
+/* G0 - primary plane                                                     */
+/* ---------------------------------------------------------------------- */
+
+void histb_vdp_hw_g0_update(struct histb_vdp *vdp, struct drm_plane_state *state)
+{
+	struct drm_framebuffer *fb = state->fb;
+	u32 w = drm_rect_width(&state->src) >> 16;
+	u32 h = drm_rect_height(&state->src) >> 16;
+	u32 x = state->dst.x1;
+	u32 y = state->dst.y1;
+	bool has_alpha = fb->format->has_alpha;
+	dma_addr_t addr = drm_fb_dma_get_gem_addr(fb, state, 0);
+	u32 ctrl;
+
+	vdp_wr(vdp, VDP_G0_ADDR, lower_32_bits(addr));
+	vdp_wr(vdp, VDP_G0_NADDR, 0);
+	vdp_wr(vdp, VDP_G0_SMMU_BYPASS0, 3);
+	vdp_wr(vdp, VDP_G0_DCMP_ADDR, 0);
+	vdp_wr(vdp, VDP_G0_DCMP_NADDR, 0);
+	vdp_wr(vdp, VDP_G0_DCMP_OFFSET, 0);
+	vdp_wr(vdp, VDP_G0_STRIDE, fb->pitches[0] / G0_STRIDE_UNIT);
+	vdp_wr(vdp, VDP_G0_IRESO, VDP_SIZE(w, h));
+	vdp_wr(vdp, VDP_G0_SFPOS, 0);
+	vdp_wr(vdp, VDP_G0_DFPOS, VDP_POS(x, y));
+	vdp_wr(vdp, VDP_G0_DLPOS, VDP_POS(x + w - 1, y + h - 1));
+	vdp_wr(vdp, VDP_G0_VFPOS, VDP_POS(x, y));
+	vdp_wr(vdp, VDP_G0_VLPOS, VDP_POS(x + w - 1, y + h - 1));
+
+	/*
+	 * [measured] the bootloader's value is 0xCC00C368 = enable | nonsecure |
+	 * read/update progressive | req_ctrl 3 | bitext 3 | ifmt 0x68; these are
+	 * exactly the flags the community driver sets, so only ifmt differs.
+	 */
+	ctrl = vdp_rd(vdp, VDP_G0_CTRL);
+	ctrl &= ~G0_CTRL_IFMT;
+	ctrl |= FIELD_PREP(G0_CTRL_IFMT, has_alpha ? G0_IFMT_ARGB8888 :
+						       G0_IFMT_KRGB8888) |
+		FIELD_PREP(G0_CTRL_BITEXT, 3) | FIELD_PREP(G0_CTRL_REQ_CTRL, 3) |
+		G0_CTRL_READ_PROG | G0_CTRL_UPDATE_PROG | G0_CTRL_NONSECURE |
+		G0_CTRL_ENABLE;
+	vdp_wr(vdp, VDP_G0_CTRL, ctrl);
+
+	/* global alpha from the plane's "alpha" property; per-pixel alpha for ARGB */
+	vdp_wr(vdp, VDP_G0_CBMPARA,
+	       FIELD_PREP(G0_CBM_GALPHA, state->alpha >> 8) |
+	       (has_alpha ? G0_CBM_PALPHA_EN : 0));
+	vdp_wr(vdp, VDP_G0_ALPHA, 0xff);
+
+	wmb();	/* framebuffer pixels and the writes above before the latch */
+	latch_g0(vdp);
+}
+
+void histb_vdp_hw_g0_disable(struct histb_vdp *vdp)
+{
+	vdp_rmw(vdp, VDP_G0_CTRL, G0_CTRL_ENABLE, 0);
+	wmb();
+	latch_g0(vdp);
+}
+
+/* ---------------------------------------------------------------------- */
+/* V0 - video plane                                                       */
+/* ---------------------------------------------------------------------- */
+
+/*
+ * One-time identity setup of the video colour core, as VDP_DRV_SetVidLayer()
+ * does it for V0/V1 on CV200 [read VT vdp_drv_vid.c:106-146]:
+ *  - VDM RGB2LMS: identity (coefficient 1, scale2p 0), enabled
+ *  - CVM_CTRL.cvm_sel = 0
+ *  - CVM1 LMS2IPT: enabled, scale2p 15 | 1<<5, identity = 1 * 2^10 * 2^(15-10) / 2
+ *    = 0x4000, out dc 0, min 0, max 0x7fff
+ * The community driver builds the same Q14 identity for the graphics CVM2.
+ */
+static void v0_chain_init(struct histb_vdp *vdp)
+{
+	unsigned int i;
+
+	if (vdp->v0_chain_ready)
+		return;
+
+	for (i = 0; i < 9; i++) {
+		vdp_wr(vdp, VDP_VDM_RGB2LMS_COEF(i), i % 4 == 0 ? 1 : 0);
+		vdp_wr(vdp, VDP_CVM1_LMS2IPT_COEF(i), i % 4 == 0 ? 0x4000 : 0);
+	}
+	vdp_wr(vdp, VDP_VDM_RGB2LMS_SCALE2P, 0);
+	vdp_wr(vdp, VDP_VDM_RGB2LMS_CTRL, 1);
+
+	vdp_rmw(vdp, VDP_CVM_CTRL, CVM_CTRL_SEL, 0);
+
+	vdp_wr(vdp, VDP_CVM1_LMS2IPT_SCALE2P, 15 | BIT(5));
+	for (i = 0; i < 3; i++)
+		vdp_wr(vdp, VDP_CVM1_LMS2IPT_OUT_DC(i), 0);
+	vdp_wr(vdp, VDP_CVM1_LMS2IPT_MIN, 0);
+	vdp_wr(vdp, VDP_CVM1_LMS2IPT_MAX, 0x7fff);
+	vdp_wr(vdp, VDP_CVM1_LMS2IPT_CTRL, 1);
+
+	vdp->v0_chain_ready = true;
+}
+
+/*
+ * YCbCr -> RGB matrices, Q10, rows R,G,B: computed from Kr/Kb (BT.601 0.299/
+ * 0.114, BT.709 0.2126/0.0722) with the 255/219 and 255/224 limited-range
+ * gains.  The vendor hands the PQ library's own table to the same registers
+ * with scale2p = 10 [read VT vdp_drv_vid.c:1455], and the PQ values are not in
+ * the tree, so "Q10 with scale2p 10" is [inferred] - the two module parameters
+ * csc_shift / csc_scale2p retune it without a rebuild.
+ */
+static const s16 csc_matrix[2][2][9] = {
+	[0] = {	/* BT.601 */
+		[0] = { 1192, 0, 1634, 1192, -401, -832, 1192, 2066, 0 },	/* limited */
+		[1] = { 1024, 0, 1436, 1024, -352, -731, 1024, 1815, 0 },	/* full */
+	},
+	[1] = {	/* BT.709 */
+		[0] = { 1192, 0, 1836, 1192, -218, -546, 1192, 2163, 0 },
+		[1] = { 1024, 0, 1613, 1024, -192, -479, 1024, 1900, 0 },
+	},
+};
+
+static void v0_program_csc(struct histb_vdp *vdp, enum drm_color_encoding enc,
+			   enum drm_color_range range)
+{
+	bool bt709 = enc != DRM_COLOR_YCBCR_BT601;
+	bool full = range == DRM_COLOR_YCBCR_FULL_RANGE;
+	const s16 *c = csc_matrix[bt709][full];
+	int sh = histb_vdp_csc_shift - 10;
+	/*
+	 * Input offsets: the PQ DC values are 10-bit domain (-64 / -512 for
+	 * limited YUV) and the vendor multiplies by 16 for the 14-bit VDM
+	 * register [read VT vdp_drv_vid.c:1419]: Y -16, C -128 in 8 bit.
+	 */
+	u32 dcy = full ? 0 : (u32)(-16 * 64) & GENMASK(13, 0);
+	u32 dcc = (u32)(-128 * 64) & GENMASK(13, 0);
+	unsigned int i;
+
+	for (i = 0; i < 9; i++) {
+		int v = sh >= 0 ? c[i] << sh : c[i] >> -sh;
+
+		vdp_wr(vdp, VDP_VDM_YUV2RGB_COEF(i), (u16)v);
+	}
+	vdp_wr(vdp, VDP_VDM_YUV2RGB_SCALE2P, histb_vdp_csc_scale2p);
+	vdp_wr(vdp, VDP_VDM_YUV2RGB_IN_DC(0), dcy);
+	vdp_wr(vdp, VDP_VDM_YUV2RGB_IN_DC(1), dcc);
+	vdp_wr(vdp, VDP_VDM_YUV2RGB_IN_DC(2), dcc);
+	for (i = 0; i < 3; i++)
+		vdp_wr(vdp, VDP_VDM_YUV2RGB_OUT_DC(i), 0);
+	/* V0 colour conversion on, V0 gamma off [read VT vdp_drv_vid.c:1436-1455] */
+	vdp_wr(vdp, VDP_VDM_YUV2RGB_CTRL, VDM_Y2R_EN | VDM_Y2R_V0_CSC_EN);
+	vdp_rmw(vdp, VDP_VDM_CTRL, 0, BIT(0));
+}
+
+static void v0_program_zme(struct histb_vdp *vdp, u32 sw, u32 sh, u32 dw, u32 dh)
+{
+	bool scaled = sw != dw || sh != dh;
+	u64 key = sw | ((u64)dw << 16) | ((u64)sh << 32) | ((u64)dh << 48);
+	u32 hsp, vsp;
+
+	/*
+	 * 1:1 runs the scaler with every luma/horizontal FIR in copy mode, the
+	 * way the BSP VPSS port does it for a 1:1 job [read histb-vpss.c:569-612].
+	 * The vertical chroma FIR stays on: it is the 4:2:0 -> 4:2:2 chroma
+	 * upsampler (zme_in_fmt 4:2:0, zme_out_fmt 4:2:2, chroma phase
+	 * -(4096 >> 2) >> 1 = -512) [read VT X	 * 1030-1050 VdpZmeComnSet].
+	 */
+	if (key != vdp->zme_key) {
+		histb_vdp_zme_load(vdp->zme_coef, sw, dw, sh, dh);
+		vdp->zme_key = key;
+		vdp_wr(vdp, VDP_V0_HLCOEFAD, lower_32_bits(vdp->zme_coef_dma));
+		vdp_wr(vdp, VDP_V0_HCCOEFAD,
+		       lower_32_bits(vdp->zme_coef_dma + 0x100) & ~0xfU);
+		vdp_wr(vdp, VDP_V0_VLCOEFAD, lower_32_bits(vdp->zme_coef_dma + 0x200));
+		vdp_wr(vdp, VDP_V0_VCCOEFAD,
+		       lower_32_bits(vdp->zme_coef_dma + 0x300) & ~0xfU);
+		wmb();
+		vdp_wr(vdp, VDP_V0_PARAUP,
+		       V0_PARAUP_HL | V0_PARAUP_HC | V0_PARAUP_VL | V0_PARAUP_VC);
+	}
+
+	hsp = FIELD_PREP(V0_HSP_HRATIO, div_u64(((u64)sw << 20), dw)) |
+	      V0_HSP_HFIR_ORDER | V0_HSP_HLMSC_EN | V0_HSP_HCHMSC_EN |
+	      (scaled ? V0_HSP_HLFIR_EN | V0_HSP_HCHFIR_EN : 0);
+	vsp = FIELD_PREP(V0_VSP_ZME_IN_FMT, 1) | FIELD_PREP(V0_VSP_ZME_OUT_FMT, 0) |
+	      V0_VSP_VLMSC_EN | V0_VSP_VCHMSC_EN | V0_VSP_VCHFIR_EN |
+	      (scaled ? V0_VSP_VLFIR_EN : 0);
+	vdp_wr(vdp, VDP_V0_HSP, hsp);
+	vdp_wr(vdp, VDP_V0_VSP, vsp);
+	vdp_wr(vdp, VDP_V0_VSR, div_u64(((u64)sh << 12), dh));
+	vdp_wr(vdp, VDP_V0_HLOFFSET, 0);
+	vdp_wr(vdp, VDP_V0_HCOFFSET, 0);
+	vdp_wr(vdp, VDP_V0_VOFFSET, (u16)-512);		/* chroma = low half, luma 0 */
+	vdp_wr(vdp, VDP_V0_VBOFFSET, (u16)-512);
+}
+
+void histb_vdp_hw_v0_update(struct histb_vdp *vdp, struct drm_plane_state *state)
+{
+	struct drm_framebuffer *fb = state->fb;
+	struct drm_gem_dma_object *gy = drm_fb_dma_get_gem_obj(fb, 0);
+	struct drm_gem_dma_object *gc = drm_fb_dma_get_gem_obj(fb, 1);
+	u32 sx = state->src.x1 >> 16, sy = state->src.y1 >> 16;
+	u32 sw = drm_rect_width(&state->src) >> 16;
+	u32 sh = drm_rect_height(&state->src) >> 16;
+	u32 dx = state->dst.x1, dy = state->dst.y1;
+	u32 dw = drm_rect_width(&state->dst), dh = drm_rect_height(&state->dst);
+	u32 W = vdp->mode.hdisplay, H = vdp->mode.vdisplay;
+	dma_addr_t ya, ca;
+	u32 ctrl;
+
+	/*
+	 * Vertical crop is done by the start address, horizontal crop by CPOS
+	 * (IRESO then spans the source line up to the crop's right edge)
+	 * [read VT vdp_drv_vid.c:495-660].  sy is even (checked), so the
+	 * half-height chroma plane starts on a whole line.
+	 */
+	ya = gy->dma_addr + fb->offsets[0] + (dma_addr_t)sy * fb->pitches[0];
+	ca = gc->dma_addr + fb->offsets[1] + (dma_addr_t)(sy / 2) * fb->pitches[1];
+
+	v0_chain_init(vdp);
+	v0_program_csc(vdp, state->color_encoding, state->color_range);
+
+	vdp_rmw(vdp, VDP_V0_PRERD, 0, V0_PRERD_EN);
+	vdp_wr(vdp, VDP_V0_16REGIONENL, 1);
+	vdp_rmw(vdp, VDP_V0_SMMU_BYPASS0, 0, 0xf);	/* regions 0,1 luma+chroma: no SMMU */
+
+	vdp_wr(vdp, VDP_V0_P0LADDR, lower_32_bits(ya));
+	vdp_wr(vdp, VDP_V0_P0CADDR, lower_32_bits(ca));
+	vdp_wr(vdp, VDP_V0_P0STRIDE,
+	       (fb->pitches[0] & 0xffff) | ((fb->pitches[1] & 0xffff) << 16));
+
+	vdp_wr(vdp, VDP_V0_IRESO, VDP_SIZE(sx + sw, sh));
+	vdp_wr(vdp, VDP_V0_CPOS, (sx & 0xfff) | (((sx + sw - 1) & 0xfff) << 12));
+	vdp_wr(vdp, VDP_V0_ORESO, VDP_SIZE(dw, dh));
+
+	v0_program_zme(vdp, sw, sh, dw, dh);
+
+	vdp_wr(vdp, VDP_V0_VFPOS, VDP_POS(dx, dy));
+	vdp_wr(vdp, VDP_V0_VLPOS, VDP_POS(dx + dw - 1, dy + dh - 1));
+	vdp_wr(vdp, VDP_V0_DFPOS, VDP_POS(dx, dy));
+	vdp_wr(vdp, VDP_V0_DLPOS, VDP_POS(dx + dw - 1, dy + dh - 1));
+	/* limited-range black in 10 bit YCbCr (Y 0x40, Cb/Cr 0x200) outside the picture */
+	vdp_wr(vdp, VDP_V0_BK, 0x04080200);
+	vdp_wr(vdp, VDP_V0_MUTE_BK, 0x04080200);
+	vdp_wr(vdp, VDP_V0_CBMPARA, 0xff);
+	vdp_wr(vdp, VDP_V0_ALPHA, 0xff);
+
+	ctrl = vdp_rd(vdp, VDP_V0_CTRL);
+	ctrl &= ~(V0_CTRL_IFMT | V0_CTRL_REQ_CTRL | V0_CTRL_UV_ORDER |
+		  V0_CTRL_CHM_RMODE | V0_CTRL_LM_RMODE | V0_CTRL_IFIR_MODE |
+		  V0_CTRL_FLIP | V0_CTRL_MUTE | V0_CTRL_DATA_WIDTH);
+	ctrl |= FIELD_PREP(V0_CTRL_IFMT, V0_IFMT_SP_420) |
+		FIELD_PREP(V0_CTRL_REQ_CTRL, 3) | V0_CTRL_NOSEC |
+		(fb->format->format == DRM_FORMAT_NV21 ? V0_CTRL_UV_ORDER : 0) |
+		FIELD_PREP(V0_CTRL_CHM_RMODE, 1) | FIELD_PREP(V0_CTRL_LM_RMODE, 1) |
+		FIELD_PREP(V0_CTRL_IFIR_MODE, 3) |
+		FIELD_PREP(V0_CTRL_DATA_WIDTH, 0) | V0_CTRL_SURFACE_EN;
+	vdp_wr(vdp, VDP_V0_CTRL, ctrl);
+
+	/* VP0 spans the whole display [read VT vdp_drv_vid.c:402-409] */
+	vdp_wr(vdp, VDP_VP0_IRESO, VDP_SIZE(W, H));
+	vdp_wr(vdp, VDP_VP0_DFPOS, 0);
+	vdp_wr(vdp, VDP_VP0_DLPOS, VDP_POS(W - 1, H - 1));
+	vdp_wr(vdp, VDP_VP0_VFPOS, 0);
+	vdp_wr(vdp, VDP_VP0_VLPOS, VDP_POS(W - 1, H - 1));
+	vdp_wr(vdp, VDP_VP0_GALPHA, 0xff);
+	vdp_rmw(vdp, VDP_VP0_CTRL, VP0_CTRL_MUTE, 0);
+
+	/*
+	 * Routing: V0 -> MIXV0 (value = layer id + 1) -> VP0, then VP0 below GP0
+	 * in the DHD0 mixer: CBM_MIX1 = VP0 | GP0 << 4 = 0x21, what
+	 * VDP_DRIVER_Initial() writes [read VT vdp_software_selfdefine.c:332-333].
+	 * The community graphics-only driver writes 0x02 instead.
+	 */
+	vdp_rmw(vdp, VDP_MIXV0_MIX, GENMASK(7, 0), 1);
+	vdp_wr(vdp, VDP_CBM_MIX1, CBM_LAYER_VP0 | (CBM_LAYER_GP0 << 4));
+
+	wmb();	/* video pixels, coefficient memory and the writes above before the latches */
+	writel(1, vdp->base + VDP_V0_UPD);
+	writel(1, vdp->base + VDP_VP0_UPD);
+	writel(1, vdp->base + VDP_HDR_UPD);
+}
+
+void histb_vdp_hw_v0_disable(struct histb_vdp *vdp)
+{
+	vdp_rmw(vdp, VDP_V0_CTRL, V0_CTRL_SURFACE_EN, 0);
+	vdp_wr(vdp, VDP_CBM_MIX1, vdp->boot.cbm_mix1);
+	wmb();
+	writel(1, vdp->base + VDP_V0_UPD);
+	writel(1, vdp->base + VDP_VP0_UPD);
+	writel(1, vdp->base + VDP_HDR_UPD);
+}
+
