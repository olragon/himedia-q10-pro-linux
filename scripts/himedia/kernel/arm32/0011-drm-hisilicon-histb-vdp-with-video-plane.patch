--- /dev/null
+++ b/drivers/gpu/drm/hisilicon/histb/histb_vdp_hw.c
@@ -0,0 +1,509 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Hi3798CV200 VDP - register programming for the G0 graphics layer and the
+ * V0 video layer.
+ *
+ * Policy: the bootloader's display pipe is ADOPTED, not re-programmed.  This
+ * file never writes DHD0 timing, the CRG, the HDMI block, the VDP soft reset
+ * or the G0 -> GP0 -> CBM route.  It writes the G0 layer registers, the V0
+ * layer registers, VP0, the video colour core (VDM/CVM1) and one mixer word
+ * (CBM_MIX1) so the video layer reaches the output.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/math64.h>
+#include <linux/seq_file.h>
+
