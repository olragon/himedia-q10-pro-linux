+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * HiSilicon Hi3798CV200 video display processor (VDP) - register map and
+ * driver structures.
+ *
+ * Provenance tags used in this driver:
+ *   [read]     taken from a named source line (community 6.12 histb-vdp.c, or
+ *              the vendor 4.4.35 SDK, "VT" = drivers/msp/drv/vo/vdp_v4_0 and
+ *              drivers/common/include/hi3798cv200/hi_reg_vdp.h)
+ *   [inferred] reasoned from those sources, not seen on hardware
+ *   [measured] seen on the running Q10 Pro (docs/261011-himedia-full-linux-goal.md)
+ *
+ * Nothing here has run on hardware yet.
+ */
+#ifndef HISTB_VDP_H
+#define HISTB_VDP_H
+
+#include <linux/bits.h>
+#include <linux/clk.h>
+#include <linux/io.h>
+#include <linux/spinlock.h>
+
+#include <drm/drm_connector.h>
+#include <drm/drm_crtc.h>
+#include <drm/drm_device.h>
+#include <drm/drm_encoder.h>
+#include <drm/drm_mode.h>
+#include <drm/drm_plane.h>
+
+/* ---- global block ------------------------------------------------------ */
+#define VDP_VOINTSTA		0x0004	/* [read] hi_reg_vdp.h */
+#define VDP_VOMSKINTSTA		0x0008	/* write 1 = clear (community: acks vblank) */
+#define VDP_VOINTMSK		0x000c
+#define  VDP_INT_DHD0_VTTHD1	BIT(0)	/* DHD0 vertical threshold 1 */
+
+/* ---- V0: video layer 0. Stride between video layers is 0x800 [read VT vdp_define.h:109] ---- */
+#define VDP_V0_CTRL		0x0800
+#define  V0_CTRL_IFMT		GENMASK(3, 0)	/* 3 = semi-planar 4:2:0 [read VT vdp_define.h:547] */
+#define  V0_IFMT_SP_420		0x3
+#define  V0_CTRL_REQ_CTRL	GENMASK(7, 5)	/* VDP_DRIVER_Initial: V0 = 3 [read VT vdp_software_selfdefine.c:308] */
+#define  V0_CTRL_NOSEC		BIT(10)
+#define  V0_CTRL_UV_ORDER	BIT(11)
+#define  V0_CTRL_CHM_RMODE	GENMASK(13, 12)	/* 1 = progressive */
+#define  V0_CTRL_LM_RMODE	GENMASK(15, 14)
+#define  V0_CTRL_IFIR_MODE	GENMASK(19, 18)	/* 3 = 6-tap FIR [read VT vdp_drv_vid.c:291] */
+#define  V0_CTRL_FLIP		BIT(26)
+#define  V0_CTRL_MUTE		BIT(27)
+#define  V0_CTRL_DATA_WIDTH	GENMASK(29, 28)	/* 0 = 8 bit, 1 = 10 bit */
+#define  V0_CTRL_SURFACE_EN	BIT(31)
+#define VDP_V0_UPD		0x0804		/* bit0 regup */
+#define VDP_V0_PRERD		0x0820		/* bit31 pre_rd_en */
+#define  V0_PRERD_EN		BIT(31)
+#define VDP_V0_IRESO		0x0828		/* [11:0] w-1, [23:12] h-1 */
+#define VDP_V0_ORESO		0x082c		/* ZME output size */
+#define VDP_V0_CBMPARA		0x0838		/* [7:0] galpha */
+#define VDP_V0_PARAUP		0x0840		/* coefficient-memory reload strobes */
+#define  V0_PARAUP_HL		BIT(0)
+#define  V0_PARAUP_HC		BIT(1)
+#define  V0_PARAUP_VL		BIT(2)
+#define  V0_PARAUP_VC		BIT(3)
+#define VDP_V0_CPOS		0x0844		/* [11:0] first x, [23:12] last x (horizontal crop) */
+#define VDP_V0_HLCOEFAD		0x0850
+#define VDP_V0_HCCOEFAD		0x0854
+#define VDP_V0_VLCOEFAD		0x0858
+#define VDP_V0_VCCOEFAD		0x085c
+#define VDP_V0_DFPOS		0x0860		/* display window, [11:0] x, [23:12] y */
+#define VDP_V0_DLPOS		0x0864		/* last pixel (inclusive) */
+#define VDP_V0_VFPOS		0x0868		/* video window */
+#define VDP_V0_VLPOS		0x086c
+#define VDP_V0_BK		0x0870
+#define VDP_V0_ALPHA		0x0874
+#define VDP_V0_MUTE_BK		0x0878
+#define VDP_V0_HSP		0x08c0
+#define  V0_HSP_HRATIO		GENMASK(23, 0)	/* in/out * 2^20 [read VT vdp_drv_vid.c:1465] */
+#define  V0_HSP_HFIR_ORDER	BIT(24)		/* CV200 forces 1 [read VT vdp_hal_vid.c:1964] */
+#define  V0_HSP_HCHFIR_EN	BIT(25)
+#define  V0_HSP_HLFIR_EN	BIT(26)
+#define  V0_HSP_HCHMSC_EN	BIT(30)
+#define  V0_HSP_HLMSC_EN	BIT(31)
+#define VDP_V0_HLOFFSET		0x08c4
+#define VDP_V0_HCOFFSET		0x08c8
+#define VDP_V0_VSP		0x08d8
+#define  V0_VSP_ZME_IN_FMT	GENMASK(20, 19)	/* 0 = 4:2:2, 1 = 4:2:0, 2 = 4:4:4 */
+#define  V0_VSP_ZME_OUT_FMT	GENMASK(22, 21)
+#define  V0_VSP_VCHFIR_EN	BIT(23)
+#define  V0_VSP_VLFIR_EN	BIT(24)
+#define  V0_VSP_VCHMSC_EN	BIT(30)
+#define  V0_VSP_VLMSC_EN	BIT(31)
+#define VDP_V0_VSR		0x08dc		/* [15:0] in/out * 2^12 */
+#define VDP_V0_VOFFSET		0x08e0		/* [15:0] chroma, [31:16] luma phase */
+#define VDP_V0_VBOFFSET		0x08e4
+#define VDP_V0_SMMU_BYPASS0	0x09a0		/* region 0 luma = bit0, chroma = bit1 ... */
+#define VDP_V0_P0LADDR		0x0a04
+#define VDP_V0_P0CADDR		0x0a08
+#define VDP_V0_P0STRIDE		0x0a0c		/* [15:0] luma, [31:16] chroma; unit [inferred] bytes */
+#define VDP_V0_16REGIONENL	0x0f00		/* VT vdp_hal_vid.c:178 writes 1 with the layer enable */
+
+/* ---- VP0: video-processing stage between V0 and the CBM mixer ---- */
+#define VDP_VP0_CTRL		0x6000
+#define  VP0_CTRL_MUTE		BIT(8)
+#define VDP_VP0_UPD		0x6004
+#define VDP_VP0_IRESO		0x6008
+#define VDP_VP0_GALPHA		0x6020
+#define VDP_VP0_DFPOS		0x6040
+#define VDP_VP0_DLPOS		0x6044
+#define VDP_VP0_VFPOS		0x6048
+#define VDP_VP0_VLPOS		0x604c
+
+/* ---- video HDR/colour core: V0 reaches VP0 through this (SDR still goes through it on CV200) ---- */
+#define VDP_VDM_CTRL		0x3400		/* bit0 v_vdm_en */
+#define VDP_VDM_YUV2RGB_CTRL	0x3500
+#define  VDM_Y2R_EN		BIT(0)
+#define  VDM_Y2R_V0_CSC_EN	BIT(1)
+#define  VDM_Y2R_V0_GAMMA_EN	BIT(8)
+#define VDP_VDM_YUV2RGB_COEF(n)	(0x3504 + 4 * (n))	/* n = 0..8 row-major, 16 bit signed */
+#define VDP_VDM_YUV2RGB_SCALE2P	0x354c
+#define VDP_VDM_YUV2RGB_IN_DC(n)  (0x3550 + 4 * (n))	/* n = 0..2, 14 bit signed */
+#define VDP_VDM_YUV2RGB_OUT_DC(n) (0x355c + 4 * (n))	/* n = 0..2, 32 bit */
+#define VDP_VDM_RGB2LMS_CTRL	0x3600
+#define VDP_VDM_RGB2LMS_COEF(n)	(0x3604 + 4 * (n))
+#define VDP_VDM_RGB2LMS_SCALE2P	0x3628
+#define VDP_CVM_CTRL		0x3900		/* bit1 cvm_sel: video wants 0 */
+#define  CVM_CTRL_SEL		BIT(1)
+#define VDP_CVM1_LMS2IPT_CTRL	0x3a00
+#define VDP_CVM1_LMS2IPT_COEF(n) (0x3a04 + 4 * (n))
+#define VDP_CVM1_LMS2IPT_SCALE2P 0x3a28
+#define VDP_CVM1_LMS2IPT_MIN	0x3a2c
+#define VDP_CVM1_LMS2IPT_MAX	0x3a30
+#define VDP_CVM1_LMS2IPT_OUT_DC(n) (0x3a34 + 4 * (n))
+#define VDP_HDR_UPD		0x3f84		/* bit0 regup */
+
+/* ---- G0: graphics layer 0 (the boot-logo layer) [read community histb-vdp.c:69-91] ---- */
+#define VDP_G0_CTRL		0x7000
+#define  G0_CTRL_IFMT		GENMASK(7, 0)
+#define  G0_IFMT_KRGB8888	0x60	/* XRGB8888 */
+#define  G0_IFMT_ARGB8888	0x68
+#define  G0_CTRL_BITEXT		GENMASK(9, 8)
+#define  G0_CTRL_REQ_CTRL	GENMASK(15, 14)
+#define  G0_CTRL_READ_PROG	BIT(26)
+#define  G0_CTRL_UPDATE_PROG	BIT(27)
+#define  G0_CTRL_NONSECURE	BIT(30)
+#define  G0_CTRL_ENABLE		BIT(31)
+#define VDP_G0_UPD		0x7004
+#define VDP_G0_ADDR		0x7010
+#define VDP_G0_NADDR		0x7018
+#define VDP_G0_STRIDE		0x701c	/* 16-byte units [measured: 0x1E0 = 7680 B] */
+#define  G0_STRIDE_UNIT		16
+#define VDP_G0_IRESO		0x7020
+#define VDP_G0_SFPOS		0x7024
+#define VDP_G0_SMMU_BYPASS0	0x7028
+#define VDP_G0_CBMPARA		0x7030
+#define  G0_CBM_GALPHA		GENMASK(7, 0)
+#define  G0_CBM_PALPHA_EN	BIT(12)
+#define VDP_G0_DCMP_ADDR	0x7050
+#define VDP_G0_DCMP_NADDR	0x7054
+#define VDP_G0_DCMP_OFFSET	0x7058
+#define VDP_G0_DFPOS		0x7080
+#define VDP_G0_DLPOS		0x7084
+#define VDP_G0_VFPOS		0x7088
+#define VDP_G0_VLPOS		0x708c
+#define VDP_G0_ALPHA		0x7094
+
+/* ---- GP0: graphics processor between G0 and the mixer (left as the bootloader set it) ---- */
+#define VDP_GP0_UPD		0x8004
+
+/* ---- mixers [read hi_reg_vdp.h offsets; prio fields VT vdp_hal_comm.c:784] ---- */
+#define VDP_MIXV0_MIX		0xb008	/* [3:0] prio0, [7:4] prio1: value = layer id + 1 */
+#define VDP_CBM_MIX1		0xb408	/* [3:0] prio0 (bottom), [7:4] prio1: VP0 = 1, GP0 = 2 */
+#define  CBM_LAYER_VP0		0x1
+#define  CBM_LAYER_GP0		0x2
+
+/* ---- DHD0: HD display channel (timing generator; never written except VTTHD) ---- */
+#define VDP_DHD0_CTRL		0xc000
+#define  DHD0_CTRL_IOP		BIT(4)	/* progressive */
+#define  DHD0_CTRL_INTF_EN	BIT(31)
+#define VDP_DHD0_VSYNC		0xc004
+#define VDP_DHD0_HSYNC1		0xc008
+#define VDP_DHD0_HSYNC2		0xc00c
+#define VDP_DHD0_PWR		0xc014
+#define VDP_DHD0_VTTHD		0xc01c
+
+#define VDP_POS(x, y)		(((x) & 0xfff) | (((y) & 0xfff) << 12))
+#define VDP_SIZE(w, h)		VDP_POS((w) - 1, (h) - 1)
+
+#define HISTB_VDP_MAX_W		4096
+#define HISTB_VDP_MAX_H		2160
+
+/* snapshot of what the bootloader left in G0, restored on unbind */
+struct histb_vdp_boot_g0 {
+	u32 ctrl, addr, naddr, stride, ireso, sfpos, dfpos, dlpos, vfpos, vlpos;
+	u32 cbmpara, alpha;
+	u32 cbm_mix1;
+	u32 vp0_ctrl;
+};
+
+struct histb_vdp {
+	struct drm_device drm;
+	void __iomem *base;
+	int irq;
+
+	struct clk_bulk_data *clks;
+	int num_clks;
+
+	struct drm_plane primary;	/* G0 */
+	struct drm_plane overlay;	/* V0 */
+	struct drm_crtc crtc;
+	struct drm_encoder encoder;
+	struct drm_connector connector;
+	struct drm_display_mode mode;	/* adopted from DHD0, never changed */
+
+	spinlock_t irq_lock;		/* VOINTMSK read-modify-write */
+	bool vblank_on;
+
+	/* ZME coefficient memory: H at +0x000 (HL, HC at +0x100), V at +0x200 (VL, VC at +0x300) */
+	void *zme_coef;
+	dma_addr_t zme_coef_dma;
+
+	bool v0_chain_ready;		/* VDM/CVM identity setup done */
+	u64 zme_key;			/* ratio class last loaded into zme_coef */
+	struct histb_vdp_boot_g0 boot;
+};
+
+#define to_histb_vdp(d)	container_of(d, struct histb_vdp, drm)
+
+static inline u32 vdp_rd(struct histb_vdp *vdp, u32 off)
+{
+	return readl_relaxed(vdp->base + off);
+}
+
+static inline void vdp_wr(struct histb_vdp *vdp, u32 off, u32 val)
+{
+	writel_relaxed(val, vdp->base + off);
+}
+
+static inline void vdp_rmw(struct histb_vdp *vdp, u32 off, u32 clr, u32 set)
+{
+	vdp_wr(vdp, off, (vdp_rd(vdp, off) & ~clr) | set);
+}
+
+/* histb_vdp_hw.c */
+int histb_vdp_hw_read_mode(struct histb_vdp *vdp, struct drm_display_mode *mode);
+bool histb_vdp_hw_boot_fb(struct histb_vdp *vdp, u32 *base, u32 *size);
+void histb_vdp_hw_snapshot_boot(struct histb_vdp *vdp);
+void histb_vdp_hw_restore_boot(struct histb_vdp *vdp);
+void histb_vdp_hw_vblank(struct histb_vdp *vdp, bool on);
+void histb_vdp_hw_g0_update(struct histb_vdp *vdp, struct drm_plane_state *state);
+void histb_vdp_hw_g0_disable(struct histb_vdp *vdp);
+void histb_vdp_hw_v0_update(struct histb_vdp *vdp, struct drm_plane_state *state);
+void histb_vdp_hw_v0_disable(struct histb_vdp *vdp);
+void histb_vdp_hw_dump(struct histb_vdp *vdp, struct seq_file *m);
+
+/* histb_vdp_zme.c */
+void histb_vdp_zme_load(void *coef, unsigned int in_w, unsigned int out_w,
+			unsigned int in_h, unsigned int out_h);
+
+extern bool histb_vdp_allow_scale;
+extern int histb_vdp_csc_scale2p;
+extern int histb_vdp_csc_shift;
+
+#endif /* HISTB_VDP_H */
