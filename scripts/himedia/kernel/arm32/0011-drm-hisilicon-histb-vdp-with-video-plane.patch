+# SPDX-License-Identifier: GPL-2.0-only
+config DRM_HISI_HISTB_VDP
+	tristate "DRM Support for HiSilicon Hi3798CV200 VDP (adopts the bootloader display)"
+	depends on DRM && OF && (ARCH_HISI || COMPILE_TEST)
+	select DRM_CLIENT_SELECTION
+	select DRM_GEM_DMA_HELPER
+	select DRM_KMS_HELPER
+	help
+	  KMS driver for the video display processor of the HiSilicon
+	  Hi3798CV200 set-top-box SoC.  It does not program the display
+	  timing: it adopts the 1080p mode the bootloader already started,
+	  exposes the G0 graphics layer as the primary plane and the V0
+	  video layer as an NV12/NV21 overlay plane that scans out
+	  physically contiguous (CMA) buffers directly.
+
+	  When loaded it takes over from simpledrm.  If M is selected the
+	  module will be called histb-vdp.
