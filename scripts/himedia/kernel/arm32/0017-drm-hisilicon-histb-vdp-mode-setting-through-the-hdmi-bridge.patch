+/*
+ * The bridge connector's modes are the sink's EDID modes.  Put the adopted mode first
+ * and make it the only PREFERRED one: the console client commits the preferred mode when
+ * the module loads, and that must be a commit for the mode already running (no hardware
+ * access), never the TV's native 4K one.  If the sink lists it with a different clock
+ * (the bootloader runs 59.94 Hz where the EDID says 60 Hz) it is added as an extra mode.
+ */
+static int histb_vdp_bconn_get_modes(struct drm_connector *conn)
+{
+	struct histb_vdp *vdp = to_histb_vdp(conn->dev);
+	struct drm_display_mode *mode;
+	bool found = false;
+	int n = vdp->bridge_conn_helpers->get_modes(conn);
+
+	list_for_each_entry(mode, &conn->probed_modes, head) {
+		if (drm_mode_match(mode, &vdp->boot_mode,
+				   DRM_MODE_MATCH_TIMINGS | DRM_MODE_MATCH_CLOCK | DRM_MODE_MATCH_FLAGS)) {
+			mode->type |= DRM_MODE_TYPE_PREFERRED;
+			found = true;
+		} else {
+			mode->type &= ~DRM_MODE_TYPE_PREFERRED;
+		}
+	}
+
+	if (!found) {
+		mode = drm_mode_duplicate(conn->dev, &vdp->boot_mode);
+		if (mode) {
+			drm_mode_probed_add(conn, mode);
+			n++;
+		}
+	}
+
+	return n;
 }
 
