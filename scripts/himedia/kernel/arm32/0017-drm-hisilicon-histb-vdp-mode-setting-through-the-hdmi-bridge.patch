--- /dev/null
+++ b/drivers/gpu/drm/hisilicon/histb/histb_vdp_mode.c
@@ -0,0 +1,315 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Hi3798CV200 VDP - mode setting.
+ *
+ * Everything in this file runs ONLY when a commit asks for a mode other than the one
+ * DHD0 is already running.  Until then the driver stays what histb_vdp_hw.c describes:
+ * an adopter of the bootloader's pipe that writes nothing but its planes.
+ *
+ * The sequence is the community 6.12.y driver's, histb-vdp.c, ported unchanged in
+ * substance (resources_enable, program_axi, program_rgb_identity_path,
+ * program_timing, the DHD0 staging order), because it is the only one of the two
+ * halves of the video chain that has run on this silicon:
+ *
+ *   1. the HDMI pixel clock is retimed FIRST (clk_set_rate on the PLL).  If it does
+ *      not lock the clock driver has already put the old plan back and nothing else
+ *      has been touched;
+ *   2. once, on the first mode change: VDP soft reset, AXI/low-power setup, the
+ *      RGB identity colour path, the G0 -> GP0 -> mixer route.  The community TX setup
+ *      (histb-hdmi) assumes this RGB chain; the bootloader's chain is a different one
+ *      (hdmi_mode 0, DHD0 colour conversion on), so the two must be switched together;
+ *   3. every time: DHD0 interface off, timing, GP0 size, interface on.
+ *
+ * Not tested on hardware.
+ */
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+
+#include <drm/drm_modes.h>
+#include <drm/drm_print.h>
+
+#include "histb_vdp.h"
+
+#define HFRONT_MAX		0x10000
+#define VFRONT_MAX		0x400
+#define VSYNC_MAX		0x100
+
+/* what DHD0's fields can express, and what this display pipe is meant to carry */
+enum drm_mode_status histb_vdp_mode_valid(const struct drm_display_mode *mode)
+{
+	u32 hfront, hsync, hback, vfront, vsync, vback;
+
+	if (mode->flags & DRM_MODE_FLAG_INTERLACE)
+		return MODE_NO_INTERLACE;
+	if (mode->flags & DRM_MODE_FLAG_DBLSCAN)
+		return MODE_NO_DBLESCAN;
+
+	if (mode->hdisplay < 320 || mode->hdisplay > HISTB_VDP_MAX_W)
+		return MODE_BAD_HVALUE;
+	if (mode->vdisplay < 240 || mode->vdisplay > HISTB_VDP_MAX_H)
+		return MODE_BAD_VVALUE;
+
+	if (mode->hsync_start <= mode->hdisplay ||
+	    mode->hsync_end <= mode->hsync_start ||
+	    mode->htotal <= mode->hsync_end)
+		return MODE_H_ILLEGAL;
+	if (mode->vsync_start <= mode->vdisplay ||
+	    mode->vsync_end <= mode->vsync_start ||
+	    mode->vtotal <= mode->vsync_end)
+		return MODE_V_ILLEGAL;
+
+	hfront = mode->hsync_start - mode->hdisplay;
+	hsync = mode->hsync_end - mode->hsync_start;
+	hback = mode->htotal - mode->hsync_end;
+	vfront = mode->vsync_start - mode->vdisplay;
+	vsync = mode->vsync_end - mode->vsync_start;
+	vback = mode->vtotal - mode->vsync_end;
+
+	if (hfront > HFRONT_MAX || hback > HFRONT_MAX)
+		return MODE_BAD_HVALUE;
+	if (hsync > HFRONT_MAX)
+		return MODE_HSYNC_WIDE;
+	if (vfront > VFRONT_MAX || vback > VFRONT_MAX)
+		return MODE_BAD_VVALUE;
+	if (vsync > VSYNC_MAX)
+		return MODE_VSYNC_WIDE;
+
+	return MODE_OK;
+}
+
+/* ---------------------------------------------------------------------- */
+/* DHD0 staging                                                           */
+/* ---------------------------------------------------------------------- */
+
+static void dhd0_stage(struct histb_vdp *vdp, u32 set, u32 clear)
+{
+	u32 ctrl = readl(vdp->base + VDP_DHD0_CTRL);
+
+	ctrl &= ~clear;
+	ctrl |= set | DHD0_CTRL_REGUP;
+	writel(ctrl, vdp->base + VDP_DHD0_CTRL);
+	readl(vdp->base + VDP_DHD0_CTRL);
+}
+
+/* ---------------------------------------------------------------------- */
+/* once: take the pipe over from the bootloader                           */
+/* ---------------------------------------------------------------------- */
+
+/* CV200 reset completion shows as both VDPVERSION words reading 0 [read CM:535] */
+static int pipe_reset(struct histb_vdp *vdp)
+{
+	u32 v1;
+	int ret;
+
+	if (!vdp->reset) {
+		drm_warn(&vdp->drm, "no VDP reset line in the device tree: taking the pipe over WITHOUT a soft reset\n");
+		return 0;
+	}
+
+	vdp_wr(vdp, VDP_VOINTMSK, 0);
+	ret = reset_control_assert(vdp->reset);
+	if (ret)
+		return ret;
+	mb();
+	udelay(10);
+	ret = readl_poll_timeout(vdp->base + VDP_VERSION1, v1,
+				 !v1 && !readl(vdp->base + VDP_VERSION2),
+				 2000, 80000);
+	if (ret)
+		drm_err(&vdp->drm,
+			"VDP reset did not complete: VDPVERSION1=%08x VDPVERSION2=%08x\n",
+			readl(vdp->base + VDP_VERSION1),
+			readl(vdp->base + VDP_VERSION2));
+
+	/* never leave the block in reset, whatever the poll said */
+	if (reset_control_deassert(vdp->reset) && !ret)
+		ret = -EIO;
+	mb();
+	udelay(10);
+
+	return ret;
+}
+
+/* Values used by the CV200 BSP VDP_DRIVER_Initial() AXI setup [read CM:545-570]. */
+static void pipe_axi(struct histb_vdp *vdp)
+{
+	vdp_wr(vdp, VDP_VOLOWPOWER_CTRL, VOLOWPOWER_DEFAULT);
+	vdp_rmw(vdp, VDP_VOMIDORDER, 0, VOMIDORDER_MID_EN);
+	vdp_rmw(vdp, VDP_VOAXICTRL, VOAXICTRL_MASK, VOAXICTRL_VALUE);
+	vdp_rmw(vdp, VDP_VOAXICTRL1, VOAXICTRL1_MASK, VOAXICTRL1_VALUE & VOAXICTRL1_MASK);
+	/* G0 is the scanout layer and uses AXI master 0 in the CV200 BSP [read CM:493] */
+	vdp_rmw(vdp, VDP_VOMASTERSEL, BIT(14), 0);
+	/*
+	 * CV200's production VO HAL ignores the caller's value and hard-codes twochn_mode=1
+	 * together with DHD0 twochn_debug=1 [read CM:967-975].
+	 */
+	vdp_rmw(vdp, VDP_VOCTRL, 0, VOCTRL_CLK_GATE_EN | VOCTRL_TWOCHN_EN | VOCTRL_TWOCHN_MODE);
+}
+
+/*
+ * The graphics chain as plain RGB end to end [read CM:578-642]: every optional colour
+ * transform off, the CVM2 stage a Q14 identity (bypassing it does not preserve the
+ * graphics sample width: adjacent pixel lanes overflow differently before the mixer).
+ */
+static void pipe_identity_path(struct histb_vdp *vdp)
+{
+	unsigned int i;
+	u32 value;
+
+	vdp_rmw(vdp, VDP_GDM_CTRL, GDM_ENABLES, 0);
+	vdp_rmw(vdp, VDP_GDM_RGB2LMS_CTRL, BIT(0), 0);
+	vdp_rmw(vdp, VDP_HDR_CTRL, HDR_ENABLES, 0);
+	vdp_rmw(vdp, VDP_G0_CSC_IDC, CSC_ENABLE_G0, 0);
+	vdp_rmw(vdp, VDP_GP0_CSC_IDC, CSC_ENABLE_GP0, 0);
+	vdp_rmw(vdp, VDP_DHD0_CSC_IDC, CSC_ENABLE_DHD0, 0);
+
+	/* clear every CVM processing latch, but preserve output metadata bits */
+	value = vdp_rd(vdp, VDP_CVM_CTRL) & ~CVM_PIPE_ENABLES;
+	vdp_wr(vdp, VDP_CVM_CTRL, value);
+	vdp_rmw(vdp, VDP_CVM1_RGB2YUV_CTRL, BIT(0), 0);
+	vdp_rmw(vdp, VDP_CVM2_RGB2YUV_CTRL, BIT(0), 0);
+	for (i = 0; i < 9; i++)
+		vdp_wr(vdp, VDP_CVM2_RGB2YUV_COEF(i), i % 4 == 0 ? CVM2_CSC_UNITY : 0);
+	vdp_wr(vdp, VDP_CVM2_RGB2YUV_SCALE2P, CVM2_CSC_PRECISION | CVM2_CSC_SCALE_EN);
+	vdp_wr(vdp, VDP_CVM2_RGB2YUV_MIN, 0);
+	vdp_wr(vdp, VDP_CVM2_RGB2YUV_MAX, 0x7fff);
+	for (i = 0; i < 3; i++)
+		vdp_wr(vdp, VDP_CVM2_RGB2YUV_OUT_DC(i), 0);
+	vdp_wr(vdp, VDP_CVM_CTRL, value | CVM_ENABLE);
+	vdp_rmw(vdp, VDP_CVM2_RGB2YUV_CTRL, 0, BIT(0));
+	vdp_wr(vdp, VDP_HDR_UPD, 1);
+}
+
+/* DHD0 -> HDMI routing, the G0 -> GP0 -> mixer route [read CM:660-700] */
+static void pipe_route(struct histb_vdp *vdp)
+{
+	/* Match the same-device DHD default while HDMI HS/VS stay non-inverted. */
+	vdp_wr(vdp, VDP_DHD0_SYNC_INV, DHD0_SYNC_INV_HSYNC);
+	vdp_rmw(vdp, VDP_VO_MUX, VO_MUX_HDMI_SEL, 0);	/* DHD0 is source zero for the HDMI path */
+	vdp_wr(vdp, VDP_DHD0_DATA_SEL, 0);
+
+	pipe_identity_path(vdp);
+	vdp_wr(vdp, VDP_DHD0_HDMI_CLIP_L, 0);
+	vdp_wr(vdp, VDP_DHD0_HDMI_CLIP_H, DHD0_CLIP_FULL);
+
+	/* G0 through GP0, GP0 the only DHD0 mixer input (this driver's V0 write adds VP0 later) */
+	vdp_wr(vdp, VDP_MIXG0_MIX, 1);
+	vdp_wr(vdp, VDP_CBM_BKG1, 0);
+	vdp_wr(vdp, VDP_CBM_MIX1, CBM_LAYER_GP0);
+
+	/* stock Linux PQ clears both scaler enables for a 1:1 framebuffer */
+	vdp_rmw(vdp, VDP_GP0_ZME_HSP, GP0_ZME_ENABLE, 0);
+	vdp_rmw(vdp, VDP_GP0_ZME_VSP, GP0_ZME_ENABLE, 0);
+	vdp_wr(vdp, VDP_GP0_CTRL, GP0_CTRL_READ_PROG | GP0_ROUTE_ZME_CSC);
+	vdp_wr(vdp, VDP_GP0_GALPHA, 0xff);
+}
+
+/* ---------------------------------------------------------------------- */
+/* every time: timing                                                     */
+/* ---------------------------------------------------------------------- */
+
+static void retime(struct histb_vdp *vdp, const struct drm_display_mode *mode)
+{
+	u32 hfront = mode->hsync_start - mode->hdisplay;
+	u32 hsync = mode->hsync_end - mode->hsync_start;
+	u32 hback = mode->htotal - mode->hsync_end;
+	u32 vfront = mode->vsync_start - mode->vdisplay;
+	u32 vsync = mode->vsync_end - mode->vsync_start;
+	u32 vback = mode->vtotal - mode->vsync_end;
+	u32 size = VDP_SIZE(mode->hdisplay, mode->vdisplay);
+	u32 last = VDP_POS(mode->hdisplay - 1, mode->vdisplay - 1);
+
+	/*
+	 * The blanking fields include the sync pulse width; the encoding is the inverse of
+	 * histb_vdp_hw_read_mode() and was checked against the measured boot values
+	 * (HSYNC1 0x00BF077F, HSYNC2 0x57, VSYNC 0x00C28437, PWR 0x0004002B = 1080p60).
+	 */
+	vdp_wr(vdp, VDP_DHD0_HSYNC1, (mode->hdisplay - 1) | ((hback + hsync - 1) << 16));
+	vdp_wr(vdp, VDP_DHD0_HSYNC2, hfront - 1);
+	vdp_wr(vdp, VDP_DHD0_VSYNC, (mode->vdisplay - 1) | ((vback + vsync - 1) << 12) |
+				    ((vfront - 1) << 22));
+	vdp_wr(vdp, VDP_DHD0_VPLUS, 0);
+	vdp_wr(vdp, VDP_DHD0_PWR, (hsync - 1) | ((vsync - 1) << 16));
+
+	/* GP0 scans the framebuffer 1:1 */
+	vdp_wr(vdp, VDP_GP0_IRESO, size);
+	vdp_wr(vdp, VDP_GP0_ORESO, size);
+	vdp_wr(vdp, VDP_GP0_DFPOS, 0);
+	vdp_wr(vdp, VDP_GP0_DLPOS, last);
+	vdp_wr(vdp, VDP_GP0_VFPOS, 0);
+	vdp_wr(vdp, VDP_GP0_VLPOS, last);
+	writel(1, vdp->base + VDP_GP0_UPD);
+	readl(vdp->base + VDP_GP0_UPD);
+	vdp_wr(vdp, VDP_HDR_UPD, 1);
+}
+
+/* ---------------------------------------------------------------------- */
+/* entry                                                                  */
+/* ---------------------------------------------------------------------- */
+
+/*
+ * Make DHD0 run @mode.  On failure the hardware is back (or still) on the previous mode
+ * and vdp->mode says so; the caller must not assume the new one is up.
+ */
+int histb_vdp_hw_set_mode(struct histb_vdp *vdp, const struct drm_display_mode *mode)
+{
+	unsigned long old_rate = vdp->mode.clock * 1000UL;
+	bool first = !vdp->owned;
+	int ret;
+
+	drm_info(&vdp->drm, "mode change %s -> " DRM_MODE_FMT "%s\n",
+		 vdp->mode.name, DRM_MODE_ARG(mode), first ? " (taking the pipe over)" : "");
+
+	/* 1. the PLL.  A failed lock was already rolled back by the clock driver. */
+	if (vdp->pixel) {
+		ret = clk_set_rate(vdp->pixel, mode->clock * 1000UL);
+		if (ret) {
+			drm_err(&vdp->drm, "pixel clock %lu Hz: %pe; staying on %s\n",
+				mode->clock * 1000UL, ERR_PTR(ret), vdp->mode.name);
+			return ret;
+		}
+	}
+
+	/* 2. once: reset and re-establish the whole chain, the way the community driver does */
+	if (first) {
+		ret = pipe_reset(vdp);
+		if (ret)
+			goto err_clock;
+		pipe_axi(vdp);
+		dhd0_stage(vdp, DHD0_CTRL_IOP | DHD0_CTRL_TWOCHN_DEBUG,
+			   DHD0_CTRL_INTF_EN | DHD0_CTRL_HDMI_MODE | DHD0_CTRL_P2I | DHD0_CTRL_CBAR);
+		pipe_route(vdp);
+	} else {
+		dhd0_stage(vdp, 0, DHD0_CTRL_INTF_EN);
+	}
+
+	/* 3. timing, then the interface on: staged exactly as the vendor does */
+	retime(vdp, mode);
+	dhd0_stage(vdp, DHD0_CTRL_IOP | DHD0_CTRL_HDMI_MODE | DHD0_CTRL_TWOCHN_DEBUG,
+		   DHD0_CTRL_INTF_EN | DHD0_CTRL_CBAR);
+	dhd0_stage(vdp, DHD0_CTRL_INTF_EN | DHD0_CTRL_IOP | DHD0_CTRL_HDMI_MODE |
+		   DHD0_CTRL_TWOCHN_DEBUG, DHD0_CTRL_CBAR);
+	dhd0_stage(vdp, 0, 0);		/* stock's second request */
+
+	vdp->mode = *mode;
+	if (first) {
+		vdp->owned = true;
+		/* a reset wiped the V0 colour core and the mixer: both are rebuilt on the next V0 update */
+		vdp->v0_chain_ready = false;
+		vdp->zme_key = 0;
+		vdp->boot.cbm_mix1 = CBM_LAYER_GP0;
+	}
+
+	/* the reset cleared the interrupt mask and the new mode needs a new threshold line */
+	histb_vdp_hw_vblank(vdp, vdp->vblank_on);
+
+	return 0;
+
+err_clock:
+	if (vdp->pixel && clk_set_rate(vdp->pixel, old_rate))
+		drm_err(&vdp->drm, "could not put the pixel clock back to %lu Hz\n", old_rate);
+	return ret;
+}
