+static int histb_vdec_mpeg4_result_to_errno(int result)
+{
+	switch (result) {
+	case HISTB_MPEG4_OK:
+		return 0;
+	case HISTB_MPEG4_NEED_MORE:
+		return -ENODATA;
+	case HISTB_MPEG4_UNSUPPORTED:
+		return -EOPNOTSUPP;
+	default:
+		return -EINVAL;
+	}
+}
