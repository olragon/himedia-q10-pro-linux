+static __le32 *histb_vdec_hevc_msg_slot(__le32 *base, unsigned int slot)
+{
+	unsigned int words = slot;
+
+	words *= HISTB_VDEC_HEVC_MSG_SLOT_WORDS;
+	return base + words;
+}
