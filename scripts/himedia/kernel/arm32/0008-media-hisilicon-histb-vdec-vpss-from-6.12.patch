+static __le32 *histb_vdec_msg_slot(struct histb_vdec_ctx *ctx,
+				   unsigned int slot)
+{
+	return ctx->buffers[HISTB_VDEC_BUF_MSG].cpu +
+	       slot * HISTB_VDEC_H264_MSG_SLOT_SIZE;
+}
