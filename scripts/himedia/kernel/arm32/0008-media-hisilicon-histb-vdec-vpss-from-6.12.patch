+static void histb_vdec_free_vc1_anchor(
+		struct histb_vdec_ctx *ctx,
+		struct histb_vdec_vc1_anchor *anchor)
+{
+	struct histb_vdec_decoded_buffer decoded = {
+		.tile = anchor->tile,
+		.pmv = anchor->pmv,
+		.tile_noncoherent = anchor->tile_noncoherent,
+	};
