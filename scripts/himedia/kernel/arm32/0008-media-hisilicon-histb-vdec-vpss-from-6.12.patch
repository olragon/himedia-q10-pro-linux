+static int histb_vdec_vc1_result_to_errno(int result)
+{
+	switch (result) {
+	case HISTB_VC1_OK:
+		return 0;
+	case HISTB_VC1_NOT_READY:
+		return -ENODATA;
+	case HISTB_VC1_UNSUPPORTED:
+		return -EOPNOTSUPP;
+	case HISTB_VC1_HW_ERROR:
+		return -EIO;
+	default:
+		return -EINVAL;
+	}
+}
