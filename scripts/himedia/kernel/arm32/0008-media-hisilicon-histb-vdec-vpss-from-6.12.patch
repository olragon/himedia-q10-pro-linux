+/* Every supported codec runs with the VDH MMU in bypass (AVS, which needed it, is not carried). */
+static void histb_vdec_smmu_bypass(struct histb_vdec_dev *vdec)
+{
+	writel(0, vdec->regs + HISTB_VDEC_SMMU_CTRL);
+}
