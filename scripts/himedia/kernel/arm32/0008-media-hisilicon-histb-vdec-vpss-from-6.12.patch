+static bool histb_vdec_dma_buffers_valid(struct histb_vdec_ctx *ctx)
+{
+	unsigned int i;
+
+	for (i = 0; i < HISTB_VDEC_BUF_COUNT; i++)
+		if (ctx->buffers[i].size &&
+		    (!ctx->buffers[i].cpu || upper_32_bits(ctx->buffers[i].dma)))
+			return false;
+
+	return true;
+}
