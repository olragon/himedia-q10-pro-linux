diff --git a/drivers/media/platform/hisilicon/histb-dma.h b/drivers/media/platform/hisilicon/histb-dma.h
new file mode 100644
index 000000000..a4ea0edb9
--- /dev/null
+++ b/drivers/media/platform/hisilicon/histb-dma.h
@@ -0,0 +1,125 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Non-coherent contiguous DMA allocation that also works for HIGHMEM pages.
+ *
+ * dma_alloc_noncoherent() is page_address(dma_alloc_pages()).  On a 32-bit
+ * kernel with CONFIG_HIGHMEM the CMA area can sit in highmem, where
+ * page_address() is NULL: the call then fails AND leaks the contiguous block
+ * it just allocated.  Those buffers (decoded surfaces, capture buffers, the
+ * VPSS staging area) are accessed by the CPU, so map highmem blocks with
+ * vmap().  Lowmem blocks keep their linear-map address, as before.
+ *
+ * The CPU mapping is cacheable.  Cache maintenance stays the caller's job,
+ * through dma_sync_single_for_{cpu,device}() on the returned handle, exactly
+ * as with dma_alloc_noncoherent().
+ *
+ * `page + i` is valid: dma_alloc_pages() returns one physically contiguous
+ * block and 6.18 removed nth_page() on that basis.
+ */
+#ifndef _HISTB_DMA_H
+#define _HISTB_DMA_H
+
+#include <linux/dma-mapping.h>
+#include <linux/highmem.h>
+#include <linux/mm.h>
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+
+/*
+ * A physically contiguous DMA block with no kernel mapping.  Returns the first
+ * page; *dma_handle is the device address.  The block is zeroed and cleaned
+ * to memory, like dma_alloc_pages() did.
+ *
+ * NOT dma_alloc_pages(): dma_direct_alloc_pages() calls
+ * __dma_direct_alloc_pages(..., allow_highmem = false), so a CMA block that
+ * sits in HIGHMEM is allocated and then thrown away, and the request falls
+ * back to the buddy allocator.  With cma=320M the whole CMA area is above
+ * lowmem, so the buddy limit (order 10 = 4 MB) became the largest buffer:
+ * every 1080p surface "worked" (3 MB) and a 4K surface or capture buffer
+ * (12.4 MB) always failed, with CMA 95% free.  dma_alloc_attrs(
+ * DMA_ATTR_NO_KERNEL_MAPPING) goes through dma_direct_alloc_no_mapping(), which
+ * allows highmem, and returns the struct page as the cookie.
+ */
+static inline struct page *histb_dma_alloc_block(struct device *dev, size_t size,
+						 dma_addr_t *dma_handle,
+						 enum dma_data_direction dir,
+						 gfp_t gfp)
+{
+	unsigned int i, count = PAGE_ALIGN(size) >> PAGE_SHIFT;
+	struct page *page;
+
+	page = dma_alloc_attrs(dev, size, dma_handle, gfp,
+			       DMA_ATTR_NO_KERNEL_MAPPING);
+	if (!page)
+		return NULL;
+	for (i = 0; i < count; i++)
+		clear_highpage(page + i);
+	dma_sync_single_for_device(dev, *dma_handle, size, dir);
+	return page;
+}
+
+static inline void histb_dma_free_block(struct device *dev, size_t size,
+					struct page *page, dma_addr_t dma_handle)
+{
+	dma_free_attrs(dev, size, page, dma_handle, DMA_ATTR_NO_KERNEL_MAPPING);
+}
+
+/* Cacheable kernel mapping of a block: linear address, or vmap() for highmem. */
+static inline void *histb_dma_map_block(struct page *page, size_t size)
+{
+	unsigned int i, count = PAGE_ALIGN(size) >> PAGE_SHIFT;
+	struct page **pages;
+	void *vaddr;
+
+	if (!PageHighMem(page))
+		return page_address(page);
+	pages = kvmalloc_array(count, sizeof(*pages), GFP_KERNEL);
+	if (!pages)
+		return NULL;
+	for (i = 0; i < count; i++)
+		pages[i] = page + i;
+	vaddr = vmap(pages, count, VM_MAP, PAGE_KERNEL);
+	kvfree(pages);
+	return vaddr;
+}
+
+static inline void histb_dma_unmap_block(void *vaddr)
+{
+	if (vaddr && is_vmalloc_addr(vaddr))
+		vunmap(vaddr);
+}
+
+static inline void *histb_dma_alloc_noncoherent(struct device *dev, size_t size,
+						dma_addr_t *dma_handle,
+						enum dma_data_direction dir,
+						gfp_t gfp)
+{
+	struct page *page;
+	void *vaddr;
+
+	page = histb_dma_alloc_block(dev, size, dma_handle, dir, gfp);
+	if (!page)
+		return NULL;
+	vaddr = histb_dma_map_block(page, size);
+	if (!vaddr)
+		histb_dma_free_block(dev, size, page, *dma_handle);
+	return vaddr;
+}
+
+static inline void histb_dma_free_noncoherent(struct device *dev, size_t size,
+					      void *vaddr,
+					      dma_addr_t dma_handle,
+					      enum dma_data_direction dir)
+{
+	struct page *page;
+
+	if (is_vmalloc_addr(vaddr)) {
+		page = vmalloc_to_page(vaddr);
+		vunmap(vaddr);
+	} else {
+		page = virt_to_page(vaddr);
+	}
+	histb_dma_free_block(dev, size, page, dma_handle);
+}
+
+#endif /* _HISTB_DMA_H */
diff --git a/drivers/media/platform/hisilicon/histb-vdec-core.c b/drivers/media/platform/hisilicon/histb-vdec-core.c
