# Q10-Dark — Windows-11-like dark window frames for openbox (flat, #202020 title, white text,
# blue focus line). Our own theme: Debian's arc-theme ships no openbox-3 variant.
border.width: 1
padding.width: 6
padding.height: 4
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap: 0

window.active.border.color: #0078d4
window.inactive.border.color: #2b2b2b
window.active.title.bg: flat solid
window.active.title.bg.color: #202020
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #2b2b2b
window.active.label.bg: parentrelative
window.inactive.label.bg: parentrelative
window.active.label.text.color: #ffffff
window.inactive.label.text.color: #9a9a9a
window.label.text.justify: left
window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #ffffff
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #3a3a3a
window.active.button.hover.image.color: #ffffff
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #0078d4
window.active.button.pressed.image.color: #ffffff
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #6a6a6a
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #9a9a9a
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #3a3a3a
window.inactive.button.hover.image.color: #ffffff
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #0078d4
window.inactive.button.pressed.image.color: #ffffff
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #6a6a6a
window.active.handle.bg: flat solid
window.active.handle.bg.color: #202020
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #2b2b2b
window.active.grip.bg: flat solid
window.active.grip.bg.color: #202020
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #2b2b2b

menu.border.width: 1
menu.border.color: #3a3a3a
menu.title.bg: flat solid
menu.title.bg.color: #202020
menu.title.text.color: #ffffff
menu.items.bg: flat solid
menu.items.bg.color: #2b2b2b
menu.items.text.color: #ffffff
menu.items.disabled.text.color: #6a6a6a
menu.items.active.bg: flat solid
menu.items.active.bg.color: #0078d4
menu.items.active.text.color: #ffffff
menu.separator.color: #3a3a3a

osd.border.width: 1
osd.border.color: #3a3a3a
osd.bg: flat solid
osd.bg.color: #202020
osd.label.text.color: #ffffff
osd.hilight.bg: flat solid
osd.hilight.bg.color: #0078d4
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #3a3a3a

window.active.label.text.font: shadow=n
window.inactive.label.text.font: shadow=n
